## variableStatement action
func term() Datum {
  let tn1 = term.struct([VariableStatement])
  let tfirst2 = true
  seq.step()
  term.setField([DeclarationList], tn1, term.read([$l]))
  tfirst2 = cover(tn1, term.read([$l]), tfirst2)
  made(term.ctx(), tn1, tfirst2)
  return term.fromObj(tn1)
}

