func term() Datum {
  let tn1 = term.struct([TryStatement])
  let tfirst2 = true
  seq.step()
  term.setField([TryBlock], tn1, term.read([$b]))
  tfirst2 = cover(tn1, term.read([$b]), tfirst2)
  seq.step()
  term.setField([CatchClause], tn1, term.read([$cc]))
  tfirst2 = cover(tn1, term.read([$cc]), tfirst2)
  seq.step()
  term.setField([FinallyBlock], tn1, term.read([$fb]))
  tfirst2 = cover(tn1, term.read([$fb]), tfirst2)
  made(term.ctx(), tn1, tfirst2)
  return term.fromObj(tn1)
