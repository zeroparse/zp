## main action
func term() (Datum, Fail) {
  return term.read([$v]), null(Fail)
}

## object action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(term.ctx(), term.name([concat]), term.read([$ms]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(term.ctx(), false, tk3)
  let tn5 = term.struct([Object])
  let tfirst6 = true
  seq.step()
  term.setField([Members], tn5, term.fromObj(tn4))
  tfirst6 = cover(tn5, term.fromObj(tn4), tfirst6)
  made(term.ctx(), tn5, tfirst6)
  return term.fromObj(tn5), null(Fail)
}

## members action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = push(term.ctx(), term.name([list]), term.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(term.name([map]), term.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$m]), term.field([m of $m]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(term.ctx(), term.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = term.elemsAbove(tm1)
  let tn11 = hull(term.ctx(), false, tk10)
  return term.fromObj(tn11), null(Fail)
}

## member action
func term() (Datum, Fail) {
  let tn1 = term.struct([Member])
  let tfirst2 = true
  seq.step()
  term.setField([Key], tn1, term.read([$k]))
  tfirst2 = cover(tn1, term.read([$k]), tfirst2)
  seq.step()
  term.setField([Value], tn1, term.read([$v]))
  tfirst2 = cover(tn1, term.read([$v]), tfirst2)
  made(term.ctx(), tn1, tfirst2)
  return term.fromObj(tn1), null(Fail)
}

## array action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(term.ctx(), term.name([concat]), term.read([$es]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(term.ctx(), false, tk3)
  let tn5 = term.struct([Array])
  let tfirst6 = true
  seq.step()
  term.setField([Elements], tn5, term.fromObj(tn4))
  tfirst6 = cover(tn5, term.fromObj(tn4), tfirst6)
  made(term.ctx(), tn5, tfirst6)
  return term.fromObj(tn5), null(Fail)
}

## elements action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = push(term.ctx(), term.name([list]), term.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
