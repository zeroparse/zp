## update_extensions_stmt action
func term() Datum {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(term.ctx(), term.name([concat]), term.read([$ns]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(term.ctx(), false, tk3)
  let tn5 = term.struct([UpdateExtensionsStmt])
  let tfirst6 = true
  seq.step()
  term.setField([With], tn5, term.read([$w]))
  tfirst6 = cover(tn5, term.read([$w]), tfirst6)
  seq.step()
  term.setField([Names], tn5, term.fromObj(tn4))
  tfirst6 = cover(tn5, term.fromObj(tn4), tfirst6)
  made(term.ctx(), tn5, tfirst6)
  return term.fromObj(tn5)
}

## main action
not lowered: New, concat, map, Lambda, param

## dq_close predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$u]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2 = term.read([var tag])
  let tv3, tf3 = binary(5, term.fromStr(ts1), tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  return tv3
}

## dollar_string binding tag
func term() Datum {
  let ts1, tf1 = text(term.read([$t]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  return term.fromStr(ts1)
}

