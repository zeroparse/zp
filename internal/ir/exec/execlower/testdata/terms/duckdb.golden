  let ts1, tf1 = text(term.read([$n]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tm2 = term.kids()
  seq.step()
  let tf3 = push(term.ctx(), term.name([list]), term.read([$a]))
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  seq.step()
  let tf4 = push(term.ctx(), term.name([list]), term.read([$b]))
  if (tf4 != null(Fail)) {
    term.raise(tf4)
  }
  let tk5 = term.elemsAbove(tm2)
  let tn6 = hull(term.ctx(), false, tk5)
  let tn7 = term.struct([SpecialCall])
  let tfirst8 = true
  seq.step()
  term.setField([Name], tn7, term.fromStr(ts1))
  tfirst8 = cover(tn7, term.fromStr(ts1), tfirst8)
  seq.step()
  term.setField([Args], tn7, term.fromObj(tn6))
  tfirst8 = cover(tn7, term.fromObj(tn6), tfirst8)
  made(term.ctx(), tn7, tfirst8)
  return term.fromObj(tn7)
}

