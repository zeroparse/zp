## dq_close predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$u]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2 = term.read([var tag])
  let tv3, tf3 = binary(5, term.fromStr(ts1), tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  return tv3
}

## dollar_string binding tag
func term() Datum {
  let ts1, tf1 = text(term.read([$t]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  return term.fromStr(ts1)
}

