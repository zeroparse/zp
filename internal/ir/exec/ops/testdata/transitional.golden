module parser
features budget, document, observe, missing, stream, typed

component memo
  // The memo table: results of rule calls by key. A key is a rule, a position,
  // a binding level and the values of the rule's variables.

component seen
  // The record of deferred memoization: which rules were called at which positions,
  // and per rule the counts that decide when it is memoized eagerly. It is created with the number of
  // rules whose memoization is deferred.

component budget
  // The work budget of the parse: the units charged so far and the limit, zero for
  // none.

component depth
  // The nesting depth of rule calls and its limit.

component env
  // The variable environment: one current value for each declared variable, in a slot
  // that the grammar fixes. An environment is persistent: a binding makes a new one and changes none that a
  // backtracking point holds. Values handles stand for the values of a rule's variables, compared by the
  // host's value equality.

component host
  // The host: values and nodes, which the parser VM passes on without reading.

component recovered
  // The list of errors recovered so far in the parse.

component rules
  // The rules of the grammar: their descriptors and bodies.

component expected
  // The expectation record: the expectations at the farthest position.

component call
  // The call bookkeeping of the target outside the call protocol: the tracked path of
  // Documents and observation.

component observe
  // The observation of a parse.

component growth
  // The left-recursion growths in progress with their seeds, the frames that record
  // what the calls in their contexts depend on, and the tables of the results kept in each context (the
  // dependency memo).

component window
  // The window of a stream parse: the input read and kept, the callback that receives the
  // elements of the #stream repetition, the recovered errors delivered so far, and the memory that the
  // delivered elements held.

component runs
  // The repetition runs of a Document: for each repetition of the last parse that a parse may
  // resume, the positions, the examined input, the value and the expectations of its elements.

component suspended
  // The calls whose rule body runs between the begin and the end of the split call
  // protocol, each with the state that its begin saved for its end in a record that its caller holds.

component frames
  // The capture frames: the frame that captures write to, the slots of each frame and the
  // trail of the writes that a reset undoes.

component operators
  // The bookkeeping of the Operators Rule loop: whether a candidate of the last longest match
  // failed after a cut.

register pos int
  // The position of the parse in the input.

register silent int
  // The depth of lookaheads, inside which expectations are not recorded.

register cut bool
  // The cut flag of the scope the parse entered last.

handle Entry of memo
  // A memo entry: the result of a rule call with its outcome and end.

handle Values of env
  // The values of a rule's variables, as a memo key.

handle Value of host
  // The value of a rule's result: a node or a typed value.

handle Errs of recovered
  // The errors recovered in a rule call, kept with its memo entry.

handle Datum of host
  // A value that a variable holds or a term produces, which only the host reads.

handle Scope of env
  // A variable environment, which bindings replace and never change.

handle Rule of rules
  // A rule's descriptor.

handle Err of recovered
  // A syntax error that a recovery made.

handle Body of rules
  // The invocation of a rule's body that a generated call passes.

handle ExpMark of expected
  // The record that an isolation set aside.

handle ExpSet of expected
  // The expectations an isolation recorded, which a target may keep where the record grows next: valid as exp.setAt requires.

handle ExpID of expected
  // An expectation: the identifier of a description or message of the grammar.

handle ExpKept of expected
  // Expectations kept beyond the record, as a memo entry keeps them.

handle Ctx of growth
  // The context state of a memoized call: the growths of its rule's cycle at its
  // position, their present set, and whether the call records its dependencies.

handle CtxResult of growth
  // A result that a context keeps (a seed, or the result of a call or a growth step
  // that read a seed), or the last result of a growth.

handle Grow of growth
  // The state of the growth of a left-recursion leader.

handle EditLog of memo
  // The edits of a Document, in order.

handle Run of runs
  // A repetition run in progress in a Document parse.

handle RunElem of runs
  // An element of an old run that the parse reuses, or none.

handle RunSite of runs
  // A repetition that a Document parse can resume.

handle Term of host
  // A term of a predicate or a binding, in the form the target evaluates.

handle CallState of suspended
  // The record of a suspended call, which its caller holds.

handle Frame of frames
  // A capture frame: the slots of the captures of a rule body or a line.

handle Mark of frames
  // A backtracking point: the position, the variable environment, the
  // recovered errors and the length of the trail when it was taken.

handle Operators of rules
  // The prefix operators of an Operators Rule, or its other operators.

handle Operator of rules
  // An operator of an Operators Rule: its kind, binding power, associativity and line.

handle Line of rules
  // A line of an Operators Rule: an operand, or the expression of an operator.

handle Attempt of operators
  // A match of an operator: the operator, where it started and ended, its value,
  // the frame of its captures, the environment after it, whether it cut, and the errors it recovered. The
  // null attempt is no match.

handle LongestState of suspended
  // The record of a suspended longest match.

handle NudState of suspended
  // The record of the suspended start of an expression.

handle ExprState of suspended
  // The record of the suspended loop of an expression.

op memo.lookup(rule int, pos int, level int, key Values, docOnly bool) (Entry, bool)
  component memo
  reads memo
  cost <= 1 + 1*key_scan + 1*pending_edits
  contract:
    // Returns the entry stored under the key, if one is there and not replaced, and true;
    // otherwise false and an entry that must not be used. Two keys are equal when their rules, positions
    // and levels are equal and the host's value equality holds for their values. A lookup with docOnly set,
    // for a rule that only a Document memoizes, finds an entry only if the values of the key are the same
    // values as those of the entry (the same bytes for a string), not merely equal, and finds none beyond
    // the first entries of a long chain: a miss is always sound, since the rule is then evaluated.
  law: two lookups with no write of memo between them return the same result

op memo.store(rule int, pos int, level int, key Values, ok bool, end int, silent bool, value Value, errs Errs, docOnly bool) Entry
  component memo
  reads memo
  writes memo
  cost <= 2 + 1*key_scan + 1*slot_growth
  contract:
    // Stores a complete entry with the outcome ok, the end, whether it was computed in a silent
    // context, its value and its recovered errors under the key, replacing the entry stored under the same
    // key, and returns it. Entries under other keys are unchanged. With docOnly set, the key of a stored
    // entry matches only the key of a lookup with the same values (see memo.lookup), so the store replaces
    // the entry of the same values only.
  requires:
    // end is at least pos. The handle of the entry that the store replaces is not used after
    // it: an implementation may reuse it for a later entry.

op memo.prune(pos int)
  component memo
  reads memo
  writes memo
  features stream
  noreturn
  cost <= 0 + 1*pruned + 3*covered
  contract:
    // Removes the entries stored at positions before pos and raises the floor of the memo to pos.
    // Below the floor the memo keeps nothing: a lookup there finds no entry, and a store there returns its
    // entry without keeping it. The removed entries are no longer valid; entries at or after pos are
    // unchanged.
  requires:
    // pos is at least the floor (memo.floor). The handles of the removed entries are not used
    // after the prune: an implementation may reuse them for later entries.

op memo.floor() int
  component memo
  reads memo
  features stream
  cost <= 0
  contract:
    // Returns the floor of the memo: 0 at the start of a parse, then the position of the last
    // memo.prune.

op memo.examine(e Entry, before bool, end int)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Records with entry e the input that the call which computed it examined, for the reuse of e
    // after an edit (memo.splice): from the position of e, or from the unit before it if before (a call
    // reads at most that unit before its position, to tell a line start), to end, exclusive. The record
    // replaces those that memo.examine and memo.pin made before.
  requires:
    // end is at or after the position of e.

op memo.examined(e Entry) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the end of the input that memo.examine recorded with entry e, or 0 if none was
    // recorded.

op memo.before(e Entry) bool
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Reports whether the input that memo.examine recorded with entry e starts before its position;
    // false if none was recorded.

op memo.pin(e Entry)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Marks entry e as depending on positions, not only on the input it examined: an edit before
    // it removes it instead of moving it (memo.splice).

op memo.splice(start int, end int, delta int)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Applies an edit of the input that replaces [start, end) with input delta units longer. An
    // entry whose recorded examined input ends at or before start stays where it is. An entry whose recorded
    // examined input starts at or after end, that is not pinned and has no recovered errors, moves by delta:
    // it is found at its position plus delta, and its end and its examined input move with it, and its
    // value moves when it is reused (doc.move). Every other entry is removed. The handles of all entries from
    // before the edit are no longer valid: a target may copy the entries it keeps. What a target records with
    // an entry besides these moves with it as that record says (memo.setExpected). The operation charges
    // nothing: a target may apply the edit to an entry when it next finds the entry instead of at once, so
    // that memo.lookup pays for it, one unit for each edit applied. Lookups then see what they would have
    // seen had the edit applied at once.
  requires:
    // 0 <= start <= end, and start <= end + delta.

op memo.ok(e Entry) bool
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns whether the call of entry e succeeded.

op memo.end(e Entry) int
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the end of the match of entry e; for a failure, the position of the call.

op memo.silent(e Entry) bool
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns whether entry e was computed in a silent context.

op memo.value(e Entry) Value
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the value of entry e.

op memo.errs(e Entry) Errs
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the recovered errors of entry e.

op seen.first(rule int, pos int) bool
  component seen
  reads seen
  writes seen
  cost <= 66 + 1*page_index + 1*pages + 1*seen_index
  contract:
    // Records a call of the rule at pos and reports whether its memoization is deferred: true
    // when the rule is not eager and has not been called at pos before. Each rule counts its calls and its
    // repeated calls, the calls at a position where it was called before. A call that finds the rule eager
    // returns false and records nothing. Otherwise the call count grows by one, and when it reaches 2^31
    // both counts are halved (rounding down); a repeated call then grows the repeat count, and when the
    // repeats exceed the calls divided by 16 (rounding down), the rule becomes eager for the rest of the
    // parse. The policy decides how
    // many rule bodies run, which the statistics report, so every target follows it exactly.
  requires:
    // 0 <= rule < the number of rules the component was created with; pos >= 0.

op budget.charge(n u64)
  component budget
  reads budget
  writes budget
  features budget
  noreturn
  cost <= 0 + 1*n
  contract:
    // Charges n units, as n charges of one unit do. When the limit is not zero and the units used
    // plus n exceed it, the parse ends with a limit interruption at the first unit that does not fit, which
    // reports the limit as the units used and one unit requested; otherwise n is added to them.
    // Charges are never rolled back. A target may also observe cancellation here, at intervals of its
    // choice, and end the parse with a cancellation interruption.
  law: charge(a); charge(b) may merge into charge(a+b) when nothing observable lies between them and no commit separates them

op budget.used() u64
  component budget
  reads budget
  features budget
  cost <= 0
  contract:
    // Returns the units charged so far: by budget.charge and inside other operations.

op budget.freeBegin(on bool) u64
  component budget
  reads budget
  writes budget
  features budget, document
  cost <= 0
  contract:
    // Opens a region of Document work when on is true, and returns the mark that budget.freeEnd takes.
    // The units that the region charges are work that only a Document parse does: a parse under the default
    // Compute limit leaves them out of the count against it, and a parse under an explicit limit counts them
    // as any other. The region must end before any work that a parse from scratch counts starts, and a region
    // does not nest. An operation that does work a parse from scratch counts inside a region, such as the
    // hash of a memo key and its comparison with each entry of the walk, counts it: it lifts the region for that
    // charge and restores it. When on is false, or the parse has no default limit, it opens no region and charges nothing.

op budget.freeEnd(mark u64)
  component budget
  reads budget
  writes budget
  features budget, document
  noreturn
  cost <= 0
  contract:
    // Ends the region that budget.freeBegin opened with mark, if it opened one. It charges nothing.

op depth.enter()
  component depth
  reads depth
  writes depth
  noreturn
  cost <= 0
  contract:
    // Enters a rule call: adds one to the depth. When the depth then exceeds the limit, the parse
    // ends with a nesting interruption.

op depth.exit()
  component depth
  reads depth
  writes depth
  cost <= 0
  contract:
    // Leaves a rule call: subtracts one from the depth.
  requires:
    // The depth is greater than zero.

op depth.current() int
  component depth
  reads depth
  cost <= 0
  contract:
    // Returns the depth.

op env.lookup(slot int) Datum
  component env
  reads env
  noreturn
  cost <= 0 + 1*env_path
  contract:
    // Returns the current value of the variable in slot.
  requires:
    // slot is the slot of a declared variable.
  law: two lookups with no write of env between them return the same value

op env.bind(slot int, v Datum)
  component env
  reads env
  writes env
  noreturn
  cost <= 1 + 1*value_compare + 1*env_rebind
  contract:
    // Makes v the value of the variable in slot, in a new environment that shares what it can with
    // the current one. When the host's value equality holds between v and the value the slot holds, the
    // environment stays the one it is, so that equal bindings keep what depends on its identity. Environments
    // that env.scope returned earlier do not change.
  requires:
    // slot is the slot of a declared variable, and v is a value that it may hold.

op env.scope() Scope
  component env
  reads env
  cost <= 0
  contract:
    // Returns the current environment, which env.restore takes.

op env.restore(s Scope)
  component env
  writes env
  cost <= 0
  contract:
    // Makes s the current environment: the bindings made since it was current are gone.

op env.key(r Rule) Values
  component env
  reads env
  noreturn
  cost <= 0 + 1*vars + 1*env_reads
  contract:
    // Returns the values of the variables the rule reads, as its memo key. Two keys are equal when
    // they have the same length and the host's value equality holds for each pair of their values. A rule that
    // reads no variable has an empty key, which costs nothing: the charge pays for reading values, and the call
    // paid for itself.

op rec.mark() int
  component recovered
  reads recovered
  cost <= 0
  contract:
    // Returns the number of entries of the list, which rec.truncate and rec.since take.

op rec.push(e Err)
  component recovered
  writes recovered
  cost <= 0
  contract:
    // Records e after the recovered errors, as one entry.

op rec.truncate(mark int)
  component recovered
  writes recovered
  cost <= 0
  contract:
    // Drops the entries after the mark, and with them their errors.
  requires:
    // mark is a mark of the list: a result of rec.mark at most its current length, and no
    // rec.since with a smaller mark has run since rec.mark returned it.

op rec.since(mark int) Errs
  component recovered
  reads recovered
  writes recovered
  noreturn
  cost <= 0 + 1*segs
  contract:
    // Returns the list of the errors recovered after the mark, and puts it in place of the
    // entries after the mark, so that the errors stay the same and the list has one entry after the mark. When
    // there is one entry after the mark, an error or a list, returns it as the list, and the list does not
    // change. When there is none, returns an empty list and the list does not change. A list never changes once
    // made: later writes of the list do not change it.
  requires:
    // mark is a mark of the list: a result of rec.mark at most its current length, and no
    // rec.since with a smaller mark has run since rec.mark returned it.

op rec.add(errs Errs)
  component recovered
  writes recovered
  cost <= 0
  contract:
    // Records the errors of errs again, after the recovered errors, as one entry that shares
    // errs; an empty list records nothing.

op rec.none(errs Errs) bool
  component recovered
  cost <= 0
  contract:
    // Reports whether the list of errors is empty.

op stream.settleErrors()
  component recovered
  writes recovered
  features stream
  noreturn
  cost <= 16
  contract:
    // Forgets the recovered errors, which were delivered and collected, and counts none as delivered.
    // It charges one unit for each slot it clears of the scratch it keeps for the next element, which holds at
    // most 16; a larger list is released without clearing it.
  requires:
    // The parse retains the tail (stream.tail), and no call holds a mark of the list.

transitional op call.tracked() bool
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Reports whether a rule call takes the target's tracked path: in a Document parse, and in the
    // node runtime also in an observed parse.

transitional op call.track(r Rule, min int) (Value, bool)
  component call
  writes call, pos, silent
  features document
  noreturn
  cost <= 0
  contract:
    // Calls the rule at the binding level min on the target's tracked path and returns its result.

transitional op call.trackBody(r Rule, inv Body) (Value, bool)
  component call
  writes call, pos, silent
  features document
  noreturn
  cost <= 0
  contract:
    // Calls the rule through the invocation inv on the target's tracked path and returns its
    // result.

transitional op call.first(r Rule) bool
  component call
  reads call
  writes call
  noreturn
  cost <= 66 + 1*page_index + 1*pages + 1*seen_index
  contract:
    // Records a call of the rule at the position and reports whether its memoization is deferred:
    // seen.first for a rule whose memoization the target defers, false for one it memoizes eagerly (in a
    // stream, or for a rule without a seen index).

op rule.memo(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule is memoized. A parse in the missing-token mode memoizes no rule that can insert a missing token.

op rule.leader(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule leads a left-recursive cycle.

op rule.plain(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule has no captures, so that its plain body serves its invocation.

op rule.docMemo(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether a Document parse memoizes the rule.

op rule.docOnlyMemo(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether a Document parse memoizes the rule and a parse from scratch does not; never for a rule that can insert a missing token in a parse in the missing-token mode.

op rule.docPlain(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether a parse from scratch calls the plain body of the rule directly, at a call site, without the call protocol.

op rule.positional(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the results of the rule may depend on positions, not only on the input they examine.

op rule.id(r Rule) int
  component rules
  cost <= 0
  contract:
    // Returns the rule's index, the rule of its memo keys.

op rule.invoke(r Rule, min int) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 1 + 1*captures + 1*capture_fields + 1*body
  contract:
    // Runs the rule's body at the binding level min in a frame of its own and makes the rule's
    // value; on failure the position is unspecified. The evaluation counts in the statistics of a Document
    // parse, and that of a rule on a cycle of calls takes a nesting level while it runs. The unit of the call
    // is charged before the nesting level is taken, so that a call that both the budget and the nesting
    // limit stop stops on the budget.

op rule.invokePlain(r Rule, min int) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 1 + 1*body + 1*tokens
  contract:
    // Runs the plain body of a rule without captures and returns its result, at the start
    // position and without the errors it recovered on failure; in the missing-token mode a failure also
    // removes the missing tokens that the body inserted, as missing.reset does. The evaluation counts, and
    // the unit of the call comes before the nesting level, as in rule.invoke.
  requires:
    // rule.plain is true of r.

transitional op rule.run(inv Body) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 0 + 1*body
  contract:
    // Runs the invocation inv of a rule at binding level 0 and returns its result; on failure the
    // position is unspecified. The evaluation does not count in the statistics of a Document parse, which
    // the caller counts with doc.evaluated.

transitional op exp.isolate(pos int) ExpMark
  component expected
  writes expected
  cost <= 0
  contract:
    // Sets the record aside and starts an empty one at pos.

transitional op exp.unisolate(m ExpMark) (int, ExpSet)
  component expected
  writes expected
  cost <= 0
  contract:
    // Ends the record that the isolation m started and restores the one set aside; returns the
    // farthest position of the ended record and its expectations.
  requires:
    // m is the innermost isolation that has not ended.

transitional op exp.farthest() int
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the farthest position of the current record.

transitional op exp.recording() bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether the parse records expectations. A parse that does not keeps one placeholder
    // entry in the record of a failure, which stands for the failure at the farthest position and is not an
    // expectation.

transitional op exp.reset(pos int)
  component expected
  writes expected
  cost <= 0
  contract:
    // Starts the current record anew at pos: the farthest position becomes pos and the entries are
    // dropped.

transitional op exp.fresh() bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether the current record has no entry.

transitional op exp.placeholder()
  component expected
  reads expected
  writes expected
  cost <= 0
  contract:
    // Adds the placeholder entry to the current record.

transitional op exp.maybe(id ExpID) bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether id may be in the current record: false means it is not; true means it may be.
  requires:
    // id is an expectation, not the placeholder.

transitional op exp.count() int
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the number of entries of the current record.

transitional op exp.at(i int) ExpID
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns entry i of the current record, in the order they were added.
  requires:
    // 0 <= i < exp.count.

transitional op exp.add(id ExpID)
  component expected
  reads expected
  writes expected
  cost <= 0
  contract:
    // Adds id to the current record, after its other entries.

transitional op exp.setCount(s ExpSet) int
  component expected
  cost <= 0
  contract:
    // Returns the number of expectations of s.

transitional op exp.setAt(s ExpSet, i int) ExpID
  component expected
  cost <= 0
  contract:
    // Returns expectation i of s, in the order they were recorded.
  requires:
    // 0 <= i < exp.setCount(s); s is the set that exp.unisolate returned last, no
    // isolation began or ended since, and every entry written to the record since then was written at an
    // index below n + i, where n is the number of entries of the record when exp.unisolate returned s.
    // Merging s into the record entry by entry, reading each entry before the write that follows it, meets
    // this.

transitional op exp.keptCount(k ExpKept) int
  component expected
  cost <= 0
  contract:
    // Returns the number of expectations of k.

transitional op exp.keptAt(k ExpKept, i int) ExpID
  component expected
  cost <= 0
  contract:
    // Returns expectation i of k, in the order they were recorded.
  requires:
    // 0 <= i < exp.keptCount(k).

transitional op exp.empty() ExpKept
  component expected
  cost <= 0
  contract:
    // Returns the kept set with no expectations.

transitional op exp.last() ExpKept
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the set that exp.copy made last in the parse, and the empty set before the first.

transitional op exp.copy(s ExpSet) ExpKept
  component expected
  reads expected
  writes expected
  noreturn
  cost <= 0 + 1*set
  contract:
    // Copies the expectations of s, in order, into a set that outlives the record, makes it the set
    // that exp.copy made last and returns it. The copy is charged as the target charges copies of values,
    // and the memory it takes as the target accounts it.
  requires:
    // s has at least one expectation, and exp.setAt may read each of them.

transitional op memo.far(e Entry) int
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the farthest position of the expectations of entry e.
  requires:
    // memo.setExpected recorded expectations with e.

transitional op memo.expected(e Entry) ExpKept
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the expectations of entry e.
  requires:
    // memo.setExpected recorded expectations with e.

transitional op memo.setExpected(e Entry, far int, k ExpKept)
  component memo
  writes memo
  cost <= 0
  contract:
    // Records the expectations k at far of the call that computed entry e. When memo.splice moves e,
    // far moves with it, by the same amount as its end.

transitional op memo.forgetDoc(e Entry)
  component memo
  writes memo
  features document
  cost <= 0
  contract:
    // Forgets the Document record of the entry e, which the call replaces, where the target keeps
    // the records beside the entries.

op ctx.enter(r Rule, min int) (Ctx, CtxResult)
  component growth
  reads growth, rules
  writes growth
  noreturn
  cost <= 1 + 1*present
  contract:
    // Begins a memoized call of the rule at the position: returns its context state and, if the
    // rule is a leader that grows at the position, its current seed, which the call reads (with the
    // dependency on its identity); otherwise the null result. The context of a call of a rule of a
    // left-recursive cycle is the growths of its cycle in progress at the position; another call has
    // none.

op ctx.found(s CtxResult) bool
  component growth
  cost <= 0
  contract:
    // Reports whether s is a result, not the null result.

op ctx.ok(s CtxResult) bool
  component growth
  reads growth
  cost <= 0
  contract:
    // Returns whether the result s succeeded.

op ctx.value(s CtxResult) Value
  component growth
  reads growth
  cost <= 0
  contract:
    // Returns the value of the result s.

transitional op ctx.replay(s CtxResult, seed bool)
  component growth
  reads growth
  writes growth, recovered, pos, silent
  noreturn
  cost <= 0 + 1*merge + 1*errs
  contract:
    // Applies the result s as the call that it records would have: counts a reuse, extends the
    // examined frontier of a Document parse, adds its expectations unless it is a seed, and on success moves
    // the position to its end and records its recovered errors again. Outside the missing-token mode it
    // records them as rec.add does, as one entry that shares their list, at no cost; in that mode it records
    // them as missing.replay does, one by one when the tokens they inserted repeat.

op ctx.allows(c Ctx, e Entry) bool
  component growth
  reads growth, memo
  cost <= 0
  contract:
    // Reports whether the call with the context state c may reuse the memo entry e: always outside a
    // context, and in one only when the leaders growing there are among those that grew where e was stored
    // (its present set). An entry holds a present set of one word of bits, so it answers no call in a context
    // with a leader that has no bit there.

op ctx.active(c Ctx) bool
  component growth
  cost <= 0
  contract:
    // Reports whether the call with the context state c is in a context.

op ctx.lookup(c Ctx, r Rule, min int, key Values) CtxResult
  component growth
  reads growth
  writes growth
  noreturn
  cost <= 0 + 1*table + 1*deps
  contract:
    // Returns the result kept in the context of the call for the rule at the position, the level
    // and the key that holds there: the seeds it read have the same identities, and the lookaheads it
    // observed the same outcomes, in the current context; it records those dependencies for the enclosing
    // call. Otherwise the null result.
  requires:
    // c is in a context.

op ctx.push(c Ctx)
  component growth
  writes growth
  cost <= 0
  contract:
    // Starts recording the dependencies of the evaluation of the call, if it is in a context.

op ctx.pop(c Ctx) int
  component growth
  reads growth
  writes growth
  cost <= 0 + 1*deps
  contract:
    // Ends recording the dependencies of the evaluation and returns where its result goes:
    // ctx.storeMemo for the memo (it read no seed, made no observation and its context's leaders all have
    // a bit in a word of bits), ctx.storeCtx for the table of the context, or another value for nowhere
    // (its context records no dependencies).

op ctx.storeMemo() int
  component growth
  cost <= 0
  contract:
    // Returns the value of ctx.pop for a result stored in the memo.

op ctx.storeCtx() int
  component growth
  cost <= 0
  contract:
    // Returns the value of ctx.pop for a result kept in the table of its context.

op memo.setPresent(e Entry, c Ctx)
  component memo
  reads growth
  writes memo
  cost <= 0
  contract:
    // Records with the entry e the present set of the context state c, for ctx.allows.
  requires:
    // The present set of c fits in a word of bits, which a call whose result ctx.pop sends to the memo meets.

op ctx.keep(c Ctx, r Rule, pos int, min int, key Values, ok bool, end int, silent bool, value Value, errs Errs, far int, k ExpKept)
  component growth
  reads growth, call
  writes growth
  noreturn
  cost <= 0 + 1*table + 1*deps
  contract:
    // Keeps the result of the call in the table of its context with the dependencies that ctx.pop
    // ended, and the examined frontier of a Document parse.
  requires:
    // The last ctx.pop of c returned ctx.storeCtx.

op ctx.done(c Ctx)
  component growth
  writes growth
  noreturn
  cost <= 0 + 1*deps
  contract:
    // Passes the dependencies that ctx.pop ended to the evaluation that encloses the call.

transitional op grow.begin(r Rule, min int) Grow
  component growth
  reads growth, rules
  writes growth
  noreturn
  cost <= 1 + 1*present
  contract:
    // Starts the growth of the leader at the binding level min at the position from a failure,
    // charging one unit: the growth is in a context when other leaders of its cycle grow at the position.

transitional op grow.next(g Grow) bool
  component growth
  reads growth
  writes growth, pos, silent
  noreturn
  cost <= 0 + 1*steps + 1*table + 1*deps + 1*merge + 1*run
  contract:
    // Reports whether the body must be evaluated for the next step of the growth g. In a context
    // it first takes the steps that the memoized steps and jumps of the context give, and starts recording
    // what the step it reports depends on.

transitional op grow.step(g Grow, value Value, ok bool)
  component growth
  reads growth
  writes growth, recovered, pos, silent
  noreturn
  cost <= 66 + 1*merge + 1*segs + 2*deps + 1*table + 1*run
  contract:
    // Receives the result of a step of the growth g: adopts it as the seed, charging one unit, and
    // returns to the start of the growth if the match grew, dropping the entries after the mark that the
    // growth took when it began, and otherwise ends the growth. A step that succeeded holds the errors it
    // recovered as the list that rec.since returns for that mark; a step that failed holds none.

transitional op grow.end(g Grow) CtxResult
  component growth
  reads growth
  writes growth, recovered, pos, silent
  noreturn
  cost <= 0 + 1*run + 1*errs
  contract:
    // Ends the growth g and returns its last seed: the position moves to its end, and its recovered
    // errors replace the entries recorded since the growth began. Outside the missing-token mode they are
    // recorded as rec.add does, at no cost; in that mode as missing.replay does.

op obs.memoHit()
  component observe
  writes observe
  features observe
  cost <= 0
  contract:
    // Counts a reuse of a memo entry in the observation, if the parse is observed.

op obs.active() bool
  component observe
  reads observe
  features observe
  cost <= 0
  contract:
    // Reports whether the parse is observed.

op obs.enter(r Rule, pos int, min int)
  component observe
  writes observe
  features observe
  noreturn
  cost <= 0
  contract:
    // Reports to the observation of the parse that a call of the rule at pos and binding level
    // min begins.
  requires:
    // The parse is observed.

op obs.exit(ok bool, pos int, examined int, known bool)
  component observe
  writes observe
  features observe
  noreturn
  cost <= 0
  contract:
    // Reports to the observation of the parse that the call that the last unmatched obs.enter began
    // ends, with its success ok, at pos, and with the end of the input it examined if known.
  requires:
    // The parse is observed, and a call that obs.enter began has not ended.

op doc.examinedBegin() int
  component call
  reads call, pos
  writes call
  features document
  cost <= 0
  contract:
    // Starts measuring how far an observed call examines the input: in a Document parse, the
    // frontier of the call starts at the position. Returns the enclosing call's frontier, for
    // doc.examinedEnd. The call itself, and any memo entry it reads or records, extends the frontier as in
    // an unobserved parse, so that observation does not change reuse. Outside a Document parse it starts
    // nothing and returns 0.

op doc.examinedEnd(enclosing int) (int, bool)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Ends measuring the frontier of an observed call and merges it into the enclosing one; returns
    // the call's frontier and true in a Document parse, and false otherwise.
  requires:
    // enclosing is the result of the matching doc.examinedBegin.

op doc.enter(pos int) (int, int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Begins a rule call at pos in a Document parse: returns the examined input of the enclosing call,
    // its end and its start, and starts the call's examined input at pos: as [pos, pos+1), or, in a target
    // whose matches extend the examined input to the end of each unit they read and whose calls do not
    // extend it past their end, as the empty range at pos.
  requires:
    // The parse reads a Document.

op doc.leave(high int, low int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Ends a rule call in a Document parse: the examined input of the enclosing call becomes the smallest
    // range that holds [low, high) and the call's.
  requires:
    // The parse reads a Document; high and low are the results of the matching doc.enter.

op doc.active() bool
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Reports whether the parse reads a Document.

op doc.touch(end int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Extends the examined frontier of the current call to end, if end is past it. A parse that reads
    // no Document keeps none.

op doc.touchFrom(from int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Extends the examined input of the current call back to from, if from is before its start. A parse
    // that reads no Document keeps none.

op doc.low() int
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Returns the start of the input that the current call examined so far.
  requires:
    // The parse reads a Document.

op doc.high() int
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Returns the examined frontier of the current call: the end of the input it examined
    // so far, exclusive.
  requires:
    // The parse reads a Document.

op doc.reused()
  component call
  writes call
  features document
  cost <= 0
  contract:
    // Counts a reused memo entry in the statistics of the Document.
  requires:
    // The parse reads a Document.

op doc.evaluated()
  component call
  writes call
  features document
  cost <= 0
  contract:
    // Counts an evaluated rule body in the statistics of the Document.
  requires:
    // The parse reads a Document.

transitional op call.body(r Rule, min int) (Value, bool)
  component call
  writes call, pos, silent
  noreturn
  cost <= 0
  contract:
    // Calls the rule at the binding level min without observation: the call, or the plain invocation,
    // that the target's observed function wraps.

host op stream.emits() bool
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Reports whether the parse delivers the elements of a #stream repetition to a callback.

host op stream.start() int
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Returns the id of the start rule of the stream parse.
  requires:
    // The parse delivers elements (stream.emits).

host op stream.check()
  component budget
  reads budget
  writes budget
  features stream
  noreturn
  cost <= 0
  contract:
    // Observes cancellation and the limits of the parse at a stream boundary, and ends the parse with
    // the interruption that applies.

host op stream.report()
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0
  contract:
    // Delivers the recovered errors committed since the last report to the diagnostic callback and the
    // retained tail. An error of the callback ends the parse with it, before the element is delivered.

host op stream.deliver(v Value)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0
  contract:
    // Passes the element v, nil for a value-free repetition, to the callback; v is final from then on.
    // An error of the callback ends the parse unchanged.
  requires:
    // The parse delivers elements.

host op stream.discard(keep int)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 1*stream_scan
  contract:
    // Discards the input before keep, when at least half of the buffer can go; later reads before keep
    // are not supported. The line and column of the new base are kept.

host op stream.release()
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 2*stream_frames
  contract:
    // Releases what the elements committed so far held: the trail, the capture frames and the node
    // chunks that no active call refers to, so that a delivered element is not kept alive through the parser.
    // The effect is memory held, which the parse result does not show.
  requires:
    // Every call of the delivered elements has returned.

host op stream.dropRecords(pos int)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 1*stream_inactive
  contract:
    // Discards what the parse keeps about the positions before pos besides the memo, which no later
    // call reads: the records of skips and of the profile, and what the inactive capacity of the trail and of a
    // target's value stack refers to. Later calls never read them, so the parse result does not show the
    // difference.

host op stream.tail() bool
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Reports whether the parse retains the tail of its recovered errors (a diagnostic limit is set).

host op doc.move(e Entry) bool
  component memo
  reads memo, host
  writes memo
  features document
  noreturn
  cost <= 0 + 2*moved + 1*move_edits
  contract:
    // Makes the value of entry e valid at the position of e, after memo.splice moved e: moves the
    // positions in the value by as much as the edits moved e since the value was made. A target that may
    // not change a value that the parse returned moves a copy; one whose contract says that a reuse moves
    // the nodes of earlier results moves them in place, where each node records how many edits its
    // positions account for. Returns false, changing nothing, when the target cannot move the value (a
    // value of the host that is not made of nodes and of basic values); the call that finds e then evaluates
    // the rule again. Returns true for an entry that no edit moved.
    // The cost has two parts. Each pass over the value charges, for each distinct node it visits, one unit
    // and one for each child and field. A target that copies checks the value and then copies it, in two
    // passes, and a refusal charges no more than the check of the nodes it reached. A target that moves in
    // place makes one pass, charges a second unit for each reference to an empty node, which it copies,
    // and for each copy it forgets at the end, and replays the edits since the generation of a node that
    // another result moved, once for each generation.

host op memo.seed(e Entry) bool
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Reports whether entry e is the seed of a growth, which no edit keeps. It guards memoAdvance: a seed
    // lives within one parse, when no edit is pending, so the guard is not reached in a parse; only a case of
    // conformance, which stores seeds without a parse, reaches it.

host op memo.from(e Entry) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the start of the input that entry e examined, as of the edits it accounts for.

host op memo.pinned(e Entry) bool
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Reports whether a call pinned entry e (memo.pin).

host op memo.shifted(e Entry) bool
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Reports whether an edit moved entry e since its value was last made valid (doc.move).

host op memo.applied(e Entry) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the number of edits that entry e accounts for.

host op memo.advance(e Entry, from int, examined int, shift int, shifted bool, applied int)
  component memo
  writes memo
  features document
  cost <= 0
  contract:
    // Records that entry e accounts for the first applied edits: its examined input is [from, examined),
    // its position, its end and the far position of its expectations move by shift, the shift of its value
    // grows by shift, and shifted tells whether its value has to move.

host op edit.count(log EditLog) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the number of edits of the log.

host op edit.start(log EditLog, i int) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the start of the input that edit i replaced.
  requires:
    // 0 <= i < edit.count(log).

host op edit.end(log EditLog, i int) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the end of the input that edit i replaced.
  requires:
    // 0 <= i < edit.count(log).

host op edit.delta(log EditLog, i int) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns how many units longer the replacement of edit i is than the input it replaced.
  requires:
    // 0 <= i < edit.count(log).

host op run.start(r Run, site RunSite)
  component runs
  reads runs
  writes runs
  features document
  cost <= 0
  contract:
    // Starts the run r of the repetition at the position. It takes over the record that this parse left
    // there, or the record of the previous parse here or where the one edit since moved it; with no such
    // record it has nothing to reuse.

host op run.prefix(r Run) RunElem
  component runs
  reads runs
  writes runs
  features document
  noreturn
  cost <= 1 + 1*merge
  contract:
    // Reuses the next old element if it examined only input before the one edit since, replaying what
    // running it did: the examined input, the expectations, the position, the reuse statistics. Returns it,
    // or none when the prefix of the run ends.

host op run.resync(r Run) bool
  component runs
  reads runs
  writes runs
  features document
  noreturn
  cost <= 0 + 1*run_search + 1*run_scan
  contract:
    // Reports whether an old element after the edit starts where the next element would, and every element from it on examined only input after the edit; run.tail then reuses them.

host op run.tail(r Run) RunElem
  component runs
  reads runs
  writes runs
  features document
  noreturn
  cost <= 1 + 1*merge + 2*moved + 1*move_edits
  contract:
    // Reuses the next old element after the edit, moved by the edit with its value (doc.move), replaying
    // what running it did as run.prefix does. Returns it, or none at the end of the run or its bound.

host op run.begin(r Run)
  component runs
  reads runs
  writes runs
  features document
  cost <= 0
  contract:
    // Starts evaluating an element: its examined input and its expectations are recorded apart from the enclosing call's.

host op run.end(r Run, ok bool, v Value)
  component runs
  reads runs
  writes runs
  features document
  noreturn
  cost <= 0 + 1*merge + 1*run_growth
  contract:
    // Ends evaluating an element, adding its examined input and its expectations to those of the enclosing call, and records it if it matched with the value v.

host op run.finish(r Run)
  component runs
  reads runs
  writes runs
  features document
  noreturn
  cost <= 0 + 1*run_elems
  contract:
    // Records the run of a repetition that matched for the next parse, unless it is too short, or recovered
    // errors, or read the seed of a growth.

transitional op term.eval(t Term) (Datum, bool)
  component host
  reads host
  writes host
  noreturn
  cost <= 0 + 1*term
  contract:
    // Evaluates t over the current capture frame with an empty span at the position, and returns its
    // value and true. A term that fails, a list element or a conversion it cannot make, returns false and may
    // leave the values it gathered and created; term.dropKids and term.dropCreated release them. An interruption
    // ends the parse and leaves them too, for the next parse starts without them.

transitional op term.created() int
  component host
  reads host
  cost <= 0
  contract:
    // Returns the mark of the nodes that terms and actions created, which term.dropCreated takes.

transitional op term.dropCreated(mark int)
  component host
  writes host
  noreturn
  cost <= 0 + 1*dropped
  contract:
    // Forgets the nodes created after the mark, without changing them, and charges one unit for each.
  requires:
    // mark came from term.created, and nothing dropped it since.

transitional op term.kids() int
  component host
  reads host
  cost <= 0
  contract:
    // Returns the mark of the values that list built-ins gather, which term.dropKids takes.

transitional op term.dropKids(mark int)
  component host
  writes host
  noreturn
  cost <= 0 + 1*dropped
  contract:
    // Drops the values gathered after the mark and charges one unit for each.
  requires:
    // mark came from term.kids, and nothing dropped it since.

transitional op term.isFalse(v Datum) bool
  component host
  cost <= 0
  contract:
    // Reports whether v is the boolean false. Any other value, nil among them, is not.

transitional op term.isFunction(v Datum) bool
  component host
  cost <= 0
  contract:
    // Reports whether v is a function, which no variable may hold.

op call.state() CallState
  component suspended
  writes suspended
  cost <= 0
  contract:
    // Returns a record for the state of a call that the caller holds until the call ends.

op call.save(st CallState, start int, min int, key Values, c Ctx, rec int, m ExpMark)
  component suspended
  writes suspended
  cost <= 0
  contract:
    // Saves in st the state that the end of the call needs: its position, its binding level, the
    // values of its key, its context state, the mark of its recovered errors and the record that its
    // isolation set aside.

op call.saveExamined(st CallState, high int, low int)
  component suspended
  writes suspended
  features document
  cost <= 0
  contract:
    // Saves in st the examined input of the enclosing call, which doc.enter returned.

op call.saveMissing(st CallState, mark int)
  component suspended
  writes suspended
  features missing
  cost <= 0
  contract:
    // Saves in st the mark of the missing-token record, which missing.mark returned.

op call.start(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the position of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.min(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the binding level of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.key(st CallState) Values
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the values of the key of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.ctx(st CallState) Ctx
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the context state of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.rec(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the mark of the recovered errors of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.mark(st CallState) ExpMark
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the record that the isolation of the call set aside that st holds.
  requires:
    // st holds a call that call.save saved.

op call.high(st CallState) int
  component suspended
  reads suspended
  features document
  cost <= 0
  contract:
    // Returns the end of the examined input of the enclosing call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.low(st CallState) int
  component suspended
  reads suspended
  features document
  cost <= 0
  contract:
    // Returns the start of the examined input of the enclosing call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.missing(st CallState) int
  component suspended
  reads suspended
  features missing
  cost <= 0
  contract:
    // Returns the mark of the missing-token record that st holds.
  requires:
    // st holds a call that call.save saved.

op missing.active() bool
  component recovered
  reads recovered
  features missing
  cost <= 0
  contract:
    // Reports whether the parse runs in the missing-token mode.

op missing.recompute(r Rule) bool
  component recovered
  reads recovered, rules
  features missing
  cost <= 0
  contract:
    // Reports whether a result of the rule is evaluated again instead of being reused from the memo:
    // the parse runs in the missing-token mode and the rule or a rule it calls can insert a missing token.

op missing.mark() int
  component recovered
  reads recovered
  features missing
  cost <= 0
  contract:
    // Returns a mark of the missing-token record, for missing.reset.

op missing.reset(mark int)
  component recovered
  writes recovered
  features missing
  cost <= 0 + 1*tokens
  contract:
    // Removes the tokens inserted after mark, in the missing-token mode; does nothing outside it.
  requires:
    // mark is a result of missing.mark at or before every later mark that is still in use.

op missing.replay(e Entry)
  component recovered
  writes recovered
  features missing
  noreturn
  cost <= 0 + 1*tokens + 1*errs
  contract:
    // Records again the tokens that the call of entry e inserted and the errors it recovered, as
    // rec.add does for the errors outside the missing-token mode.
  requires:
    // The parse runs in the missing-token mode.

op frame.mark() Mark
  component frames
  reads frames, env, recovered
  cost <= 0
  contract:
    // Returns a backtracking point at the position.

op frame.markPos(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the position of the backtracking point m.

op frame.markRec(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the number of the errors recovered before the backtracking point m, as rec.mark does.

op frame.markEnv(m Mark) Scope
  component frames
  cost <= 0
  contract:
    // Returns the variable environment of the backtracking point m.

op frame.markMissing(m Mark) int
  component frames
  features missing
  cost <= 0
  contract:
    // Returns the mark of the missing-token record at the backtracking point m, as missing.mark does.

op frame.markTrail(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the length of the trail at the backtracking point m.

op frame.undo(trail int)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*trail
  contract:
    // Undoes the writes of the trail after its first trail writes, in reverse order, charging one unit
    // for each, and drops them: every slot they wrote has the value it had before.
  requires:
    // trail is at most the length of the trail.

op frame.current() Frame
  component frames
  reads frames
  cost <= 0
  contract:
    // Returns the frame that captures write to.

op frame.use(f Frame)
  component frames
  writes frames
  cost <= 0
  contract:
    // Makes f the frame that captures write to.

op frame.open(n int) Frame
  component frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Returns a new frame of n empty slots, which lives until the parse ends. A frame of no slots is
    // never written, so it may be shared.

op frame.set(slot int, v Value)
  component frames
  reads frames
  writes frames
  cost <= 0
  contract:
    // Writes v to the slot of the current frame and adds the slot's old value to the trail. The write
    // is free: its size depends on nothing, the match that made v paid for itself, and frame.undo charges for
    // each write it undoes.
  requires:
    // slot is a slot of the current frame.

op frame.close(f Frame)
  component frames
  writes frames
  cost <= 0
  contract:
    // Ends f, which nothing refers to any more: a rule's frame when the rule returns. A target may
    // reuse it, and one without a pool of frames does nothing.
  requires:
    // No trail entry and no current frame refer to f.

op frame.slots(f Frame) int
  component frames
  cost <= 0
  contract:
    // Returns the number of slots of f.

op frame.save(f Frame)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Copies the slots of f aside, charging the copy as the target charges copies of values.

op frame.restore(f Frame)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Copies the slots that the last frame.save set aside back into f, charging the copy as
    // frame.save does.
  requires:
    // The last frame.save copied the slots of f, and nothing parsed since.

op opr.led(r Rule) Operators
  component rules
  cost <= 0
  contract:
    // Returns the infix and postfix operators of the Operators Rule r, in declaration order.

op opr.prefix(r Rule) Operators
  component rules
  cost <= 0
  contract:
    // Returns the prefix operators of the Operators Rule r, in declaration order.

op opr.count(l Operators) int
  component rules
  cost <= 0
  contract:
    // Returns the number of operators of l.

op opr.at(l Operators, i int) Operator
  component rules
  cost <= 0
  contract:
    // Returns operator i of l.
  requires:
    // 0 <= i < opr.count(l).

op opr.operands(r Rule) int
  component rules
  cost <= 0
  contract:
    // Returns the number of operand lines of the Operators Rule r.

op opr.operand(r Rule, i int) Line
  component rules
  cost <= 0
  contract:
    // Returns operand line i of the Operators Rule r, in declaration order.
  requires:
    // 0 <= i < opr.operands(r).

op opr.line(op Operator) Line
  component rules
  cost <= 0
  contract:
    // Returns the line of the operator op.

op opr.level(op Operator) int
  component rules
  cost <= 0
  contract:
    // Returns the binding power of the operator op: the higher, the tighter it binds.

op opr.infix(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op is an infix operator.

op opr.postfix(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op is a postfix operator.

op opr.right(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op associates to the right.

op opr.nonAssoc(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op does not associate.

op opr.scope(l Line) int
  component rules
  cost <= 0
  contract:
    // Returns the number of capture slots of the line l.

op opr.hasSkip(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the Operators Rule r skips trivia between its operands and operators.

transitional op opr.skip(r Rule) bool
  component rules
  writes rules, pos, silent, cut
  noreturn
  cost <= 0
  contract:
    // Runs the trivia expression of the Operators Rule r and reports whether it matched; on failure
    // the position is unspecified.
  requires:
    // opr.hasSkip(r).

transitional op opr.match(l Line) (Value, bool)
  component rules
  writes rules, pos, silent, cut
  noreturn
  cost <= 0
  contract:
    // Runs the expression of the line l in the current frame and returns its value and success; on
    // failure the position is unspecified. A cut in the expression sets the cut register.

transitional op opr.lineValue(r Rule, l Line, f Frame, v Value, start int) Value
  component host
  reads frames
  writes host
  noreturn
  cost <= 0
  contract:
    // Returns the value of the operand line l of the rule r that matched from start to the position
    // with the value v and the captures of f: the line's action, or its shaped value with its captures.

transitional op opr.build(r Rule, a Attempt, lhs Value, rhs Value) Value
  component host
  reads operators, frames
  writes host
  noreturn
  cost <= 0
  contract:
    // Returns the value of the application of the operator of a to lhs (null for a prefix operator)
    // and rhs (null for a postfix operator), which ends at the position: the action of the operator's line,
    // or the node of the tuple (lhs, operator, rhs) with the line's captures.

transitional op opr.buildTyped(r Rule, a Attempt, lhs Value, lstart int, rhs Value) (Value, int)
  component host
  reads operators, frames
  writes host
  features typed
  noreturn
  cost <= 0
  contract:
    // Is opr.build for typed values, where lhs, if it is not a node, starts at lstart; it also returns
    // where the value of the application starts.

op opr.attempt(op Operator, f Frame, v Value, start int, cut bool, errs Errs) Attempt
  component operators
  reads env, pos
  cost <= 0
  contract:
    // Returns the match of op from start to the position with the value v, the captures of f, the
    // variable environment, the cut flag cut and the recovered errors errs.

transitional op opr.attemptMissing(op Operator, f Frame, v Value, start int, cut bool, errs Errs, mark int) Attempt
  component operators
  reads env, pos, recovered
  features missing
  noreturn
  cost <= 0
  contract:
    // Is opr.attempt in a parse that can insert missing tokens: the match also holds a copy of the tokens
    // inserted after mark.

transitional op opr.replay(a Attempt)
  component recovered
  reads operators
  writes recovered
  features missing
  noreturn
  cost <= 0 + 1*errs
  contract:
    // Records again the tokens that the match a inserted and the errors it recovered, as rec.add does for
    // the errors outside the missing-token mode.

op opr.found(a Attempt) bool
  component operators
  cost <= 0
  contract:
    // Reports whether a is a match, not the null attempt.

op opr.op(a Attempt) Operator
  component operators
  cost <= 0
  contract:
    // Returns the operator of the match a.
  requires:
    // opr.found(a).

op opr.end(a Attempt) int
  component operators
  cost <= 0
  contract:
    // Returns where the match a ended.
  requires:
    // opr.found(a).

op opr.cut(a Attempt) bool
  component operators
  cost <= 0
  contract:
    // Reports whether the match a cut.
  requires:
    // opr.found(a).

op opr.env(a Attempt) Scope
  component operators
  cost <= 0
  contract:
    // Returns the variable environment after the match a.
  requires:
    // opr.found(a).

op opr.errs(a Attempt) Errs
  component operators
  cost <= 0
  contract:
    // Returns the errors that the match a recovered.
  requires:
    // opr.found(a).

op opr.setCutFailed(failed bool)
  component operators
  writes operators
  cost <= 0
  contract:
    // Records whether a candidate of the longest match failed after a cut.

op opr.cutFailed() bool
  component operators
  reads operators
  cost <= 0
  contract:
    // Reports what the last opr.setCutFailed recorded.

op opr.setNudBound(bound int)
  component operators
  writes operators
  cost <= 0
  contract:
    // Records the binding level above which no operator can follow the start of an expression.

op opr.nudBound() int
  component operators
  reads operators
  cost <= 0
  contract:
    // Returns what the last opr.setNudBound recorded.

op opr.setAfterEmpty(empty bool)
  component operators
  writes operators
  cost <= 0
  contract:
    // Records whether the right operand that the next expression parses follows an infix operator applied without consuming input.

op opr.afterEmpty() bool
  component operators
  reads operators
  cost <= 0
  contract:
    // Returns what the last opr.setAfterEmpty recorded.

op oprLongest.l(st LongestState) Operators
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the field l of the record st: what the last set of it stored, and before the
    // first the zero value of its type (0, false, the list of no operators, the zero backtracking point, no frame,
    // value or match).

op oprLongest.setL(st LongestState, x Operators)
  component suspended
  writes suspended
  cost <= 0
  contract:
    // Sets the field l of the record st to x.

