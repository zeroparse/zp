module parser
features budget, document, observe, missing, stream, typed

component memo
  // The memo table: results of rule calls by key. A key is a rule, a position,
  // a binding level and the values of the rule's variables.

component seen
  // The record of deferred memoization: which rules were called at which positions,
  // and per rule the counts that decide when it is memoized eagerly. It is created with the number of
  // rules whose memoization is deferred.

component budget
  // The work budget of the parse: the units charged so far and the limit, zero for
  // none.

component depth
  // The nesting depth of rule calls and its limit.

component env
  // The variable environment. Its operations are not declared yet; Values handles
  // stand for the values of a rule's variables, compared by the host's value equality.

component host
  // The host: values and nodes, which the parser VM passes on without reading.

component recovered
  // The list of errors recovered so far in the parse.

component rules
  // The rules of the grammar: their descriptors and bodies.

component expected
  // The expectation record: the expectations at the farthest position.

component call
  // The call bookkeeping of the target outside the call protocol: the tracked path of
  // Documents and observation.

component observe
  // The observation of a parse.

component growth
  // The left-recursion growths in progress with their seeds, the frames that record
  // what the calls in their contexts depend on, and the tables of the results kept in each context (the
  // dependency memo).

component window
  // The window of a stream parse: the input read and kept, the callback that receives the
  // elements of the #stream repetition, the recovered errors delivered so far, and the memory that the
  // delivered elements held.

component suspended
  // The calls whose rule body runs between the begin and the end of the split call
  // protocol, each with the state that its begin saved for its end in a record that its caller holds.

component frames
  // The capture frames: the frame that captures write to, the slots of each frame and the
  // trail of the writes that a reset undoes.

component operators
  // The bookkeeping of the Operators Rule loop: whether a candidate of the last longest match
  // failed after a cut.

register pos int
  // The position of the parse in the input.

register silent int
  // The depth of lookaheads, inside which expectations are not recorded.

register cut bool
  // The cut flag of the scope the parse entered last.

handle Entry of memo
  // A memo entry: the result of a rule call with its outcome and end.

handle Values of env
  // The values of a rule's variables, as a memo key.

handle Value of host
  // The value of a rule's result: a node or a typed value.

handle Errs of recovered
  // The errors recovered in a rule call, kept with its memo entry.

handle Rule of rules
  // A rule's descriptor.

handle Body of rules
  // The invocation of a rule's body that a generated call passes.

handle ExpMark of expected
  // The record that an isolation set aside.

handle ExpSet of expected
  // The expectations an isolation recorded, valid until the next record.

handle ExpID of expected
  // An expectation: the identifier of a description or message of the grammar.

handle ExpKept of expected
  // Expectations kept beyond the record, as a memo entry keeps them.

handle Ctx of growth
  // The context state of a memoized call: the growths of its rule's cycle at its
  // position, their present set, and whether the call records its dependencies.

handle CtxResult of growth
  // A result that a context keeps (a seed, or the result of a call or a growth step
  // that read a seed), or the last result of a growth.

handle Grow of growth
  // The state of the growth of a left-recursion leader.

handle CallState of suspended
  // The record of a suspended call, which its caller holds.

handle Frame of frames
  // A capture frame: the slots of the captures of a rule body or a line.

handle Mark of frames
  // A backtracking point: the position, the variable environment, the
  // recovered errors and the length of the trail when it was taken.

handle Scope of env
  // A variable environment, which bindings replace and never change.

handle Operators of rules
  // The prefix operators of an Operators Rule, or its other operators.

handle Operator of rules
  // An operator of an Operators Rule: its kind, binding power, associativity and line.

handle Line of rules
  // A line of an Operators Rule: an operand, or the expression of an operator.

handle Attempt of operators
  // A match of an operator: the operator, where it started and ended, its value,
  // the frame of its captures, the environment after it, whether it cut, and the errors it recovered. The
  // null attempt is no match.

handle LongestState of suspended
  // The record of a suspended longest match.

handle NudState of suspended
  // The record of the suspended start of an expression.

handle ExprState of suspended
  // The record of the suspended loop of an expression.

op memo.lookup(rule int, pos int, level int, key Values) (Entry, bool)
  component memo
  reads memo
  cost <= 1 + 1*key_scan
  contract:
    // Returns the entry stored under the key, if one is there and not replaced, and true;
    // otherwise false and an entry that must not be used. Two keys are equal when their rules, positions
    // and levels are equal and the host's value equality holds for their values.
  law: two lookups with no write of memo between them return the same result

op memo.store(rule int, pos int, level int, key Values, ok bool, end int, silent bool, value Value, errs Errs) Entry
  component memo
  reads memo
  writes memo
  cost <= 2 + 1*key_scan + 1*slot_growth
  contract:
    // Stores a complete entry with the outcome ok, the end, whether it was computed in a silent
    // context, its value and its recovered errors under the key, replacing the entry stored under the same
    // key, and returns it. Entries under other keys are unchanged.
  requires:
    // end is at least pos. The handle of the entry that the store replaces is not used after
    // it: an implementation may reuse it for a later entry.

op memo.prune(pos int)
  component memo
  reads memo
  writes memo
  features stream
  noreturn
  cost <= 0 + 1*pruned + 3*covered
  contract:
    // Removes the entries stored at positions before pos and raises the floor of the memo to pos.
    // Below the floor the memo keeps nothing: a lookup there finds no entry, and a store there returns its
    // entry without keeping it. The removed entries are no longer valid; entries at or after pos are
    // unchanged.
  requires:
    // pos is at least the floor (memo.floor). The handles of the removed entries are not used
    // after the prune: an implementation may reuse them for later entries.

op memo.floor() int
  component memo
  reads memo
  features stream
  cost <= 0
  contract:
    // Returns the floor of the memo: 0 at the start of a parse, then the position of the last
    // memo.prune.

op memo.examine(e Entry, before bool, end int)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Records with entry e the input that the call which computed it examined, for the reuse of e
    // after an edit (memo.splice): from the position of e, or from the unit before it if before (a call
    // reads at most that unit before its position, to tell a line start), to end, exclusive. The record
    // replaces those that memo.examine and memo.pin made before.
  requires:
    // end is at or after the position of e.

op memo.examined(e Entry) int
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Returns the end of the input that memo.examine recorded with entry e, or 0 if none was
    // recorded.

op memo.before(e Entry) bool
  component memo
  reads memo
  features document
  cost <= 0
  contract:
    // Reports whether the input that memo.examine recorded with entry e starts before its position;
    // false if none was recorded.

op memo.pin(e Entry)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Marks entry e as depending on positions, not only on the input it examined: an edit before
    // it removes it instead of moving it (memo.splice).

op memo.splice(start int, end int, delta int)
  component memo
  reads memo
  writes memo
  features document
  cost <= 0
  contract:
    // Applies an edit of the input that replaces [start, end) with input delta units longer. An
    // entry whose recorded examined input ends at or before start stays where it is. An entry whose recorded
    // examined input starts at or after end, that is not pinned and has no recovered errors, moves by delta:
    // it is found at its position plus delta, and its end and its examined input move with it, and its
    // value moves when it is reused (doc.move). Every other entry is removed. The handles of all entries from
    // before the edit are no longer valid: a target may copy the entries it keeps. What a target records with
    // an entry besides these moves with it as that record says (memo.setExpected).
  requires:
    // 0 <= start <= end, and start <= end + delta.

op memo.ok(e Entry) bool
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns whether the call of entry e succeeded.

op memo.end(e Entry) int
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the end of the match of entry e; for a failure, the position of the call.

op memo.silent(e Entry) bool
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns whether entry e was computed in a silent context.

op memo.value(e Entry) Value
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the value of entry e.

op memo.errs(e Entry) Errs
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the recovered errors of entry e.

op seen.first(rule int, pos int) bool
  component seen
  reads seen
  writes seen
  cost <= 66 + 1*page_index + 1*pages + 1*seen_index
  contract:
    // Records a call of the rule at pos and reports whether its memoization is deferred: true
    // when the rule is not eager and has not been called at pos before. Each rule counts its calls and its
    // repeated calls, the calls at a position where it was called before. A call that finds the rule eager
    // returns false and records nothing. Otherwise the call count grows by one, and when it reaches 2^31
    // both counts are halved (rounding down); a repeated call then grows the repeat count, and when the
    // repeats exceed the calls divided by 16 (rounding down), the rule becomes eager for the rest of the
    // parse. The policy decides how
    // many rule bodies run, which the statistics report, so every target follows it exactly.
  requires:
    // 0 <= rule < the number of rules the component was created with; pos >= 0.

op budget.charge(n u64)
  component budget
  reads budget
  writes budget
  features budget
  noreturn
  cost <= 0 + 1*n
  contract:
    // Charges n units. When the limit is not zero and the units used plus n exceed it, the parse
    // ends with a limit interruption and the units used are unchanged; otherwise n is added to them.
    // Charges are never rolled back. A target may also observe cancellation here, at intervals of its
    // choice, and end the parse with a cancellation interruption.
  law: charge(a); charge(b) may merge into charge(a+b) when nothing observable lies between them and no commit separates them

op budget.used() u64
  component budget
  reads budget
  features budget
  cost <= 0
  contract:
    // Returns the units charged so far: by budget.charge and inside other operations.

op depth.enter()
  component depth
  reads depth
  writes depth
  noreturn
  cost <= 0
  contract:
    // Enters a rule call: adds one to the depth. When the depth then exceeds the limit, the parse
    // ends with a nesting interruption.

op depth.exit()
  component depth
  reads depth
  writes depth
  cost <= 0
  contract:
    // Leaves a rule call: subtracts one from the depth.
  requires:
    // The depth is greater than zero.

op depth.current() int
  component depth
  reads depth
  cost <= 0
  contract:
    // Returns the depth.

transitional op call.tracked() bool
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Reports whether a rule call takes the target's tracked path: in a Document parse, and in the
    // node runtime also in an observed parse.

transitional op call.track(r Rule, min int) (Value, bool)
  component call
  writes call, pos, silent
  features document
  noreturn
  cost <= 0
  contract:
    // Calls the rule at the binding level min on the target's tracked path and returns its result.

transitional op call.trackBody(r Rule, inv Body) (Value, bool)
  component call
  writes call, pos, silent
  features document
  noreturn
  cost <= 0
  contract:
    // Calls the rule through the invocation inv on the target's tracked path and returns its
    // result.

transitional op call.first(r Rule) bool
  component call
  reads call
  writes call
  noreturn
  cost <= 66 + 1*page_index + 1*pages + 1*seen_index
  contract:
    // Records a call of the rule at the position and reports whether its memoization is deferred:
    // seen.first for a rule whose memoization the target defers, false for one it memoizes eagerly (in a
    // stream, or for a rule without a seen index).

transitional op rule.memo(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule is memoized.

transitional op rule.leader(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule leads a left-recursive cycle.

transitional op rule.plain(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the rule has no captures, so that its plain body serves its invocation.

transitional op rule.docMemo(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether a Document parse memoizes the rule.

transitional op rule.positional(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the results of the rule may depend on positions, not only on the input they examine.

transitional op rule.id(r Rule) int
  component rules
  cost <= 0
  contract:
    // Returns the rule's index, the rule of its memo keys.

transitional op rule.invoke(r Rule, min int) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 0
  contract:
    // Runs the rule's body at the binding level min in a frame of its own and makes the rule's
    // value; on failure the position is unspecified.

transitional op rule.invokePlain(r Rule, min int) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 0
  contract:
    // Runs the plain body of a rule without captures and returns its result, at the start
    // position on failure.

transitional op rule.run(inv Body) (Value, bool)
  component rules
  writes rules, pos, silent
  noreturn
  cost <= 0
  contract:
    // Runs the invocation inv of a rule at binding level 0 and returns its result.

transitional op env.memoKey(r Rule) Values
  component env
  reads env
  noreturn
  cost <= 1 + 1*vars + 1*env_reads
  contract:
    // Returns the values of the variables the rule reads, as its memo key.

transitional op rec.mark() int
  component recovered
  reads recovered
  cost <= 0
  contract:
    // Returns the number of recovered errors, which rec.truncate and rec.since take.

transitional op rec.truncate(mark int)
  component recovered
  writes recovered
  cost <= 0
  contract:
    // Drops the errors recovered after the mark.

transitional op rec.since(mark int) Errs
  component recovered
  reads recovered
  writes recovered
  noreturn
  cost <= 0 + 1*errs
  contract:
    // Returns a copy of the errors recovered after the mark, charging their copy as the target charges
    // copies of values.

transitional op rec.add(errs Errs)
  component recovered
  writes recovered
  noreturn
  cost <= 0 + 1*errs
  contract:
    // Records the errors again, after the recovered errors, charging their copy as the target
    // charges copies of values.

transitional op rec.none(errs Errs) bool
  component recovered
  cost <= 0
  contract:
    // Reports whether the list of errors is empty.

transitional op exp.isolate(pos int) ExpMark
  component expected
  writes expected
  cost <= 0
  contract:
    // Sets the record aside and starts an empty one at pos.

transitional op exp.unisolate(m ExpMark) (int, ExpSet)
  component expected
  writes expected
  cost <= 0
  contract:
    // Ends the record that the isolation m started and restores the one set aside; returns the
    // farthest position of the ended record and its expectations.

transitional op exp.farthest() int
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the farthest position of the current record.

transitional op exp.recording() bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether the parse records expectations. A parse that does not keeps one placeholder
    // entry in the record of a failure, which stands for the failure at the farthest position and is not an
    // expectation.

transitional op exp.reset(pos int)
  component expected
  writes expected
  cost <= 0
  contract:
    // Starts the current record anew at pos: the farthest position becomes pos and the entries are
    // dropped.

transitional op exp.fresh() bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether the current record has no entry.

transitional op exp.placeholder()
  component expected
  reads expected
  writes expected
  cost <= 0
  contract:
    // Adds the placeholder entry to the current record.

transitional op exp.maybe(id ExpID) bool
  component expected
  reads expected
  cost <= 0
  contract:
    // Reports whether id may be in the current record: false means it is not; true means it may be.

transitional op exp.count() int
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the number of entries of the current record.

transitional op exp.at(i int) ExpID
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns entry i of the current record, in the order they were added.
  requires:
    // 0 <= i < exp.count.

transitional op exp.add(id ExpID)
  component expected
  reads expected
  writes expected
  cost <= 0
  contract:
    // Adds id to the current record, after its other entries.

transitional op exp.setCount(s ExpSet) int
  component expected
  cost <= 0
  contract:
    // Returns the number of expectations of s.

transitional op exp.setAt(s ExpSet, i int) ExpID
  component expected
  cost <= 0
  contract:
    // Returns expectation i of s, in the order they were recorded.
  requires:
    // 0 <= i < exp.setCount(s).

transitional op exp.keptCount(k ExpKept) int
  component expected
  cost <= 0
  contract:
    // Returns the number of expectations of k.

transitional op exp.keptAt(k ExpKept, i int) ExpID
  component expected
  cost <= 0
  contract:
    // Returns expectation i of k, in the order they were recorded.
  requires:
    // 0 <= i < exp.keptCount(k).

transitional op exp.empty() ExpKept
  component expected
  cost <= 0
  contract:
    // Returns the kept set with no expectations.

transitional op exp.last() ExpKept
  component expected
  reads expected
  cost <= 0
  contract:
    // Returns the set that exp.copy made last in the parse, and the empty set before the first.

transitional op exp.copy(s ExpSet) ExpKept
  component expected
  reads expected
  writes expected
  noreturn
  cost <= 0 + 1*set
  contract:
    // Copies the expectations of s, in order, into a set that outlives the record, makes it the set
    // that exp.copy made last and returns it. The copy is charged as the target charges copies of values,
    // and the memory it takes as the target accounts it.
  requires:
    // s has at least one expectation.

transitional op memo.far(e Entry) int
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the farthest position of the expectations of entry e.

transitional op memo.expected(e Entry) ExpKept
  component memo
  reads memo
  cost <= 0
  contract:
    // Returns the expectations of entry e.

transitional op memo.setExpected(e Entry, far int, k ExpKept)
  component memo
  writes memo
  cost <= 0
  contract:
    // Records the expectations k at far of the call that computed entry e. When memo.splice moves e,
    // far moves with it, by the same amount as its end.

transitional op memo.forgetDoc(e Entry)
  component memo
  writes memo
  features document
  cost <= 0
  contract:
    // Forgets the Document record of the entry e, which the call replaces, where the target keeps
    // the records beside the entries.

transitional op ctx.enter(r Rule, min int) (Ctx, CtxResult)
  component growth
  reads growth, rules
  writes growth
  noreturn
  cost <= 1
  contract:
    // Begins a memoized call of the rule at the position: returns its context state and, if the
    // rule is a leader that grows at the position, its current seed, which the call reads (with the
    // dependency on its identity); otherwise the null result. The context of a call of a rule of a
    // left-recursive cycle is the growths of its cycle in progress at the position; another call has
    // none.

transitional op ctx.found(s CtxResult) bool
  component growth
  cost <= 0
  contract:
    // Reports whether s is a result, not the null result.

transitional op ctx.ok(s CtxResult) bool
  component growth
  reads growth
  cost <= 0
  contract:
    // Returns whether the result s succeeded.

transitional op ctx.value(s CtxResult) Value
  component growth
  reads growth
  cost <= 0
  contract:
    // Returns the value of the result s.

transitional op ctx.replay(s CtxResult, seed bool)
  component growth
  reads growth
  writes growth, pos, silent
  noreturn
  cost <= 0 + 1*merge + 1*errs
  contract:
    // Applies the result s as the call that it records would have: counts a reuse, extends the
    // examined frontier of a Document parse, adds its expectations unless it is a seed, and on success moves
    // the position to its end and records its recovered errors again.

transitional op ctx.allows(c Ctx, e Entry) bool
  component growth
  reads growth, memo
  cost <= 0
  contract:
    // Reports whether the call with the context state c may reuse the memo entry e: always outside a
    // context, and in one only when the leaders growing there are among those that grew where e was stored
    // (its present set).

transitional op ctx.active(c Ctx) bool
  component growth
  cost <= 0
  contract:
    // Reports whether the call with the context state c is in a context.

transitional op ctx.lookup(c Ctx, r Rule, min int, key Values) CtxResult
  component growth
  reads growth
  writes growth
  noreturn
  cost <= 0 + 1*table + 1*deps
  contract:
    // Returns the result kept in the context of the call for the rule at the position, the level
    // and the key that holds there: the seeds it read have the same identities, and the lookaheads it
    // observed the same outcomes, in the current context; it records those dependencies for the enclosing
    // call. Otherwise the null result.
  requires:
    // c is in a context.

transitional op ctx.push(c Ctx)
  component growth
  writes growth
  cost <= 0
  contract:
    // Starts recording the dependencies of the evaluation of the call, if it is in a context.

transitional op ctx.pop(c Ctx) int
  component growth
  reads growth
  writes growth
  cost <= 0
  contract:
    // Ends recording the dependencies of the evaluation and returns where its result goes:
    // ctx.storeMemo for the memo (it read no seed and made no observation), ctx.storeCtx for the table of
    // the context, or another value for nowhere (its context's leaders have no present set).

transitional op ctx.storeMemo() int
  component growth
  cost <= 0
  contract:
    // Returns the value of ctx.pop for a result stored in the memo.

transitional op ctx.storeCtx() int
  component growth
  cost <= 0
  contract:
    // Returns the value of ctx.pop for a result kept in the table of its context.

transitional op memo.setPresent(e Entry, c Ctx)
  component memo
  reads growth
  writes memo
  cost <= 0
  contract:
    // Records with the entry e the present set of the context state c, for ctx.allows.

transitional op ctx.keep(c Ctx, r Rule, pos int, min int, key Values, ok bool, end int, silent bool, value Value, errs Errs, far int, k ExpKept)
  component growth
  reads growth, call
  writes growth
  noreturn
  cost <= 0 + 1*table + 1*deps
  contract:
    // Keeps the result of the call in the table of its context with the dependencies that ctx.pop
    // ended, and the examined frontier of a Document parse.
  requires:
    // The last ctx.pop of c returned ctx.storeCtx.

transitional op ctx.done(c Ctx)
  component growth
  writes growth
  noreturn
  cost <= 0 + 1*deps
  contract:
    // Passes the dependencies that ctx.pop ended to the evaluation that encloses the call.

transitional op grow.begin(r Rule, min int) Grow
  component growth
  reads growth, rules
  writes growth
  noreturn
  cost <= 1
  contract:
    // Starts the growth of the leader at the binding level min at the position from a failure,
    // charging one unit: the growth is in a context when other leaders of its cycle grow at the position.

transitional op grow.next(g Grow) bool
  component growth
  reads growth
  writes growth, pos, silent
  noreturn
  cost <= 0 + 1*steps + 1*table + 1*deps + 1*merge + 1*run
  contract:
    // Reports whether the body must be evaluated for the next step of the growth g. In a context
    // it first takes the steps that the memoized steps and jumps of the context give, and starts recording
    // what the step it reports depends on.

transitional op grow.step(g Grow, value Value, ok bool)
  component growth
  reads growth
  writes growth, pos, silent
  noreturn
  cost <= 66 + 1*merge + 1*errs + 2*deps + 1*table + 1*run
  contract:
    // Receives the result of a step of the growth g: adopts it as the seed, charging one unit, and
    // returns to the start of the growth if the match grew, and otherwise ends the growth.

transitional op grow.end(g Grow) CtxResult
  component growth
  reads growth
  writes growth, pos, silent
  noreturn
  cost <= 0 + 1*run + 1*errs
  contract:
    // Ends the growth g and returns its last seed: the position moves to its end and its recovered
    // errors replace those recorded since the growth began.

transitional op obs.memoHit()
  component observe
  writes observe
  features observe
  cost <= 0
  contract:
    // Counts a reuse of a memo entry in the observation, if the parse is observed.

transitional op obs.active() bool
  component observe
  reads observe
  features observe
  cost <= 0
  contract:
    // Reports whether the parse is observed.

transitional op obs.enter(r Rule, pos int, min int)
  component observe
  writes observe
  features observe
  noreturn
  cost <= 0
  contract:
    // Reports to the observation of the parse that a call of the rule at pos and binding level
    // min begins.
  requires:
    // The parse is observed.

transitional op obs.exit(ok bool, pos int, examined int, known bool)
  component observe
  writes observe
  features observe
  noreturn
  cost <= 0
  contract:
    // Reports to the observation of the parse that the call that the last unmatched obs.enter began
    // ends, with its success ok, at pos, and with the end of the input it examined if known.
  requires:
    // The parse is observed.

transitional op doc.examinedBegin() int
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Starts measuring how far an observed call examines the input: in a Document parse, the
    // frontier of the call starts at the position. Returns the enclosing call's frontier, for
    // doc.examinedEnd. The call itself, and any memo entry it reads or records, extends the frontier as in
    // an unobserved parse, so that observation does not change reuse.

transitional op doc.examinedEnd(enclosing int) (int, bool)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Ends measuring the frontier of an observed call and merges it into the enclosing one; returns
    // the call's frontier and true in a Document parse, and false otherwise.
  requires:
    // enclosing is the result of the matching doc.examinedBegin.

transitional op doc.enter(pos int) (int, int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Begins a rule call at pos in a Document parse: returns the examined input of the enclosing call,
    // its end and its start, and starts the call's examined input at pos: as [pos, pos+1), or, in a target
    // whose matches extend the examined input to the end of each unit they read and whose calls do not
    // extend it past their end, as the empty range at pos.

transitional op doc.leave(high int, low int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Ends a rule call in a Document parse: the examined input of the enclosing call becomes the smallest
    // range that holds [low, high) and the call's.
  requires:
    // high and low are the results of the matching doc.enter.

transitional op doc.active() bool
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Reports whether the parse reads a Document.

transitional op doc.touch(end int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Extends the examined frontier of the current call to end, if end is past it.

transitional op doc.touchFrom(from int)
  component call
  reads call
  writes call
  features document
  cost <= 0
  contract:
    // Extends the examined input of the current call back to from, if from is before its start.

transitional op doc.low() int
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Returns the start of the input that the current call examined so far.
  requires:
    // The parse reads a Document.

transitional op doc.high() int
  component call
  reads call
  features document
  cost <= 0
  contract:
    // Returns the examined frontier of the current call: the end of the input it examined
    // so far, exclusive.
  requires:
    // The parse reads a Document.

transitional op doc.reused()
  component call
  writes call
  features document
  cost <= 0
  contract:
    // Counts a reused memo entry in the statistics of the Document.
  requires:
    // The parse reads a Document.

transitional op doc.evaluated()
  component call
  writes call
  features document
  cost <= 0
  contract:
    // Counts an evaluated rule body in the statistics of the Document.
  requires:
    // The parse reads a Document.

transitional op call.body(r Rule, min int) (Value, bool)
  component call
  writes call, pos, silent
  noreturn
  cost <= 0
  contract:
    // Calls the rule at the binding level min without observation: the call, or the plain invocation,
    // that the target's observed function wraps.

host op stream.emits() bool
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Reports whether the parse delivers the elements of a #stream repetition to a callback.

host op stream.start() int
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Returns the id of the start rule of the stream parse.
  requires:
    // The parse delivers elements (stream.emits).

host op stream.check()
  component budget
  reads budget
  writes budget
  features stream
  noreturn
  cost <= 0
  contract:
    // Observes cancellation and the limits of the parse at a stream boundary, and ends the parse with
    // the interruption that applies.

host op stream.report()
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0
  contract:
    // Delivers the recovered errors committed since the last report to the diagnostic callback and the
    // retained tail. An error of the callback ends the parse with it, before the element is delivered.

host op stream.deliver(v Value)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0
  contract:
    // Passes the element v, nil for a value-free repetition, to the callback; v is final from then on.
    // An error of the callback ends the parse unchanged.
  requires:
    // The parse delivers elements.

host op stream.discard(keep int)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 1*stream_scan
  contract:
    // Discards the input before keep, when at least half of the buffer can go; later reads before keep
    // are not supported. The line and column of the new base are kept.

host op stream.release()
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 2*stream_frames
  contract:
    // Releases what the elements committed so far held: the trail, the capture frames and the node
    // chunks that no active call refers to, so that a delivered element is not kept alive through the parser.
    // The effect is memory held, which the parse result does not show.
  requires:
    // Every call of the delivered elements has returned.

host op stream.dropRecords(pos int)
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 0 + 1*stream_inactive
  contract:
    // Discards what the parse keeps about the positions before pos besides the memo, which no later
    // call reads: the records of skips and of the profile, and what the inactive capacity of the trail and of a
    // target's value stack refers to. Later calls never read them, so the parse result does not show the
    // difference.

host op stream.tail() bool
  component window
  reads window
  features stream
  cost <= 0
  contract:
    // Reports whether the parse retains the tail of its recovered errors (a diagnostic limit is set).

host op doc.move(e Entry) bool
  component memo
  reads memo, host
  writes memo
  features document
  noreturn
  cost <= 0 + 2*moved
  contract:
    // Makes the value of entry e valid at the position of e, after memo.splice moved e: moves the
    // positions in the value by as much as the edits moved e since the value was made, in a copy, since the
    // value may be part of a result that the parse returned. Returns false, changing nothing, when the
    // target cannot move the value (a value of the host that is not made of nodes and of basic values);
    // the call that finds e then evaluates the rule again. Returns true for an entry that no edit moved.
    // The target checks the value before it copies it; each pass charges, for each distinct node it visits,
    // one unit and one for each child and field, which is what the cost bounds: a refusal charges no more
    // than the check of the nodes it reached.

transitional op stream.settleErrors()
  component window
  reads window
  writes window
  features stream
  noreturn
  cost <= 16
  contract:
    // Forgets the recovered errors before the boundary, which were delivered and collected, keeping at
    // most 16 slots of scratch for the next element. It is transitional: recovery bookkeeping has no Exec IR form.
  requires:
    // The parse retains the tail (stream.tail).

op call.state() CallState
  component suspended
  writes suspended
  cost <= 0
  contract:
    // Returns a record for the state of a call that the caller holds until the call ends.

op call.save(st CallState, start int, min int, key Values, c Ctx, rec int, m ExpMark)
  component suspended
  writes suspended
  cost <= 0
  contract:
    // Saves in st the state that the end of the call needs: its position, its binding level, the
    // values of its key, its context state, the mark of its recovered errors and the record that its
    // isolation set aside.

op call.saveExamined(st CallState, high int, low int)
  component suspended
  writes suspended
  features document
  cost <= 0
  contract:
    // Saves in st the examined input of the enclosing call, which doc.enter returned.

op call.saveMissing(st CallState, mark int)
  component suspended
  writes suspended
  features missing
  cost <= 0
  contract:
    // Saves in st the mark of the missing-token record, which missing.mark returned.

op call.start(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the position of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.min(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the binding level of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.key(st CallState) Values
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the values of the key of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.ctx(st CallState) Ctx
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the context state of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.rec(st CallState) int
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the mark of the recovered errors of the call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.mark(st CallState) ExpMark
  component suspended
  reads suspended
  cost <= 0
  contract:
    // Returns the record that the isolation of the call set aside that st holds.
  requires:
    // st holds a call that call.save saved.

op call.high(st CallState) int
  component suspended
  reads suspended
  features document
  cost <= 0
  contract:
    // Returns the end of the examined input of the enclosing call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.low(st CallState) int
  component suspended
  reads suspended
  features document
  cost <= 0
  contract:
    // Returns the start of the examined input of the enclosing call that st holds.
  requires:
    // st holds a call that call.save saved.

op call.missing(st CallState) int
  component suspended
  reads suspended
  features missing
  cost <= 0
  contract:
    // Returns the mark of the missing-token record that st holds.
  requires:
    // st holds a call that call.save saved.

transitional op missing.active() bool
  component recovered
  reads recovered
  features missing
  cost <= 0
  contract:
    // Reports whether the parse runs in the missing-token mode.

transitional op missing.recompute(r Rule) bool
  component recovered
  reads recovered, rules
  features missing
  cost <= 0
  contract:
    // Reports whether a result of the rule is evaluated again instead of being reused from the memo:
    // the parse runs in the missing-token mode and the rule or a rule it calls can insert a missing token.

transitional op missing.mark() int
  component recovered
  reads recovered
  features missing
  cost <= 0
  contract:
    // Returns a mark of the missing-token record, for missing.reset.

transitional op missing.reset(mark int)
  component recovered
  writes recovered
  features missing
  cost <= 0
  contract:
    // Removes the tokens inserted after mark, in the missing-token mode; does nothing outside it.
  requires:
    // mark is a result of missing.mark at or before every later mark that is still in use.

transitional op missing.replay(e Entry)
  component recovered
  writes recovered
  features missing
  noreturn
  cost <= 0 + 1*errs
  contract:
    // Records again the tokens that the call of entry e inserted and the errors it recovered, as
    // rec.add does for the errors outside the missing-token mode.
  requires:
    // The parse runs in the missing-token mode.

transitional op frame.mark() Mark
  component frames
  reads frames, env, recovered
  cost <= 0
  contract:
    // Returns a backtracking point at the position.

transitional op frame.markPos(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the position of the backtracking point m.

transitional op frame.markRec(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the number of the errors recovered before the backtracking point m, as rec.mark does.

transitional op frame.markEnv(m Mark) Scope
  component frames
  cost <= 0
  contract:
    // Returns the variable environment of the backtracking point m.

transitional op frame.markMissing(m Mark) int
  component frames
  features missing
  cost <= 0
  contract:
    // Returns the mark of the missing-token record at the backtracking point m, as missing.mark does.

transitional op frame.markTrail(m Mark) int
  component frames
  cost <= 0
  contract:
    // Returns the length of the trail at the backtracking point m.

transitional op frame.undo(trail int)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*trail
  contract:
    // Undoes the writes of the trail after its first trail writes, in reverse order, charging one unit
    // for each, and drops them: every slot they wrote has the value it had before.
  requires:
    // trail is at most the length of the trail.

transitional op frame.current() Frame
  component frames
  reads frames
  cost <= 0
  contract:
    // Returns the frame that captures write to.

transitional op frame.use(f Frame)
  component frames
  writes frames
  cost <= 0
  contract:
    // Makes f the frame that captures write to.

transitional op frame.open(n int) Frame
  component frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Returns a new frame of n empty slots, which lives until the parse ends. A frame of no slots is
    // never written, so it may be shared.

transitional op frame.slots(f Frame) int
  component frames
  cost <= 0
  contract:
    // Returns the number of slots of f.

transitional op frame.save(f Frame)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Copies the slots of f aside, charging the copy as the target charges copies of values.

transitional op frame.restore(f Frame)
  component frames
  reads frames
  writes frames
  noreturn
  cost <= 0 + 1*slots
  contract:
    // Copies the slots that the last frame.save set aside back into f, charging the copy as
    // frame.save does.
  requires:
    // The last frame.save copied the slots of f, and nothing parsed since.

transitional op env.restore(s Scope)
  component env
  writes env
  cost <= 0
  contract:
    // Makes s the variable environment.

transitional op opr.led(r Rule) Operators
  component rules
  cost <= 0
  contract:
    // Returns the infix and postfix operators of the Operators Rule r, in declaration order.

transitional op opr.prefix(r Rule) Operators
  component rules
  cost <= 0
  contract:
    // Returns the prefix operators of the Operators Rule r, in declaration order.

transitional op opr.count(l Operators) int
  component rules
  cost <= 0
  contract:
    // Returns the number of operators of l.

transitional op opr.at(l Operators, i int) Operator
  component rules
  cost <= 0
  contract:
    // Returns operator i of l.
  requires:
    // 0 <= i < opr.count(l).

transitional op opr.operands(r Rule) int
  component rules
  cost <= 0
  contract:
    // Returns the number of operand lines of the Operators Rule r.

transitional op opr.operand(r Rule, i int) Line
  component rules
  cost <= 0
  contract:
    // Returns operand line i of the Operators Rule r, in declaration order.
  requires:
    // 0 <= i < opr.operands(r).

transitional op opr.line(op Operator) Line
  component rules
  cost <= 0
  contract:
    // Returns the line of the operator op.

transitional op opr.level(op Operator) int
  component rules
  cost <= 0
  contract:
    // Returns the binding power of the operator op: the higher, the tighter it binds.

transitional op opr.infix(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op is an infix operator.

transitional op opr.postfix(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op is a postfix operator.

transitional op opr.right(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op associates to the right.

transitional op opr.nonAssoc(op Operator) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the operator op does not associate.

transitional op opr.scope(l Line) int
  component rules
  cost <= 0
  contract:
    // Returns the number of capture slots of the line l.

transitional op opr.hasSkip(r Rule) bool
  component rules
  cost <= 0
  contract:
    // Reports whether the Operators Rule r skips trivia between its operands and operators.

transitional op opr.skip(r Rule) bool
  component rules
  writes rules, pos, silent, cut
  noreturn
  cost <= 0
  contract:
    // Runs the trivia expression of the Operators Rule r and reports whether it matched; on failure
    // the position is unspecified.
  requires:
    // opr.hasSkip(r).

transitional op opr.match(l Line) (Value, bool)
  component rules
  writes rules, pos, silent, cut
  noreturn
  cost <= 0
  contract:
    // Runs the expression of the line l in the current frame and returns its value and success; on
    // failure the position is unspecified. A cut in the expression sets the cut register.

transitional op opr.lineValue(r Rule, l Line, f Frame, v Value, start int) Value
  component host
  reads frames
  writes host
  noreturn
  cost <= 0
  contract:
    // Returns the value of the operand line l of the rule r that matched from start to the position
    // with the value v and the captures of f: the line's action, or its shaped value with its captures.

transitional op opr.build(r Rule, a Attempt, lhs Value, rhs Value) Value
  component host
  reads operators, frames
  writes host
  noreturn
  cost <= 0
  contract:
    // Returns the value of the application of the operator of a to lhs (null for a prefix operator)
    // and rhs (null for a postfix operator), which ends at the position: the action of the operator's line,
    // or the node of the tuple (lhs, operator, rhs) with the line's captures.

transitional op opr.buildTyped(r Rule, a Attempt, lhs Value, lstart int, rhs Value) (Value, int)
  component host
  reads operators, frames
  writes host
  features typed
  noreturn
  cost <= 0
  contract:
    // Is opr.build for typed values, where lhs, if it is not a node, starts at lstart; it also returns
    // where the value of the application starts.

transitional op opr.attempt(op Operator, f Frame, v Value, start int, cut bool, errs Errs) Attempt
  component operators
  reads env, pos
  cost <= 0
  contract:
    // Returns the match of op from start to the position with the value v, the captures of f, the
    // variable environment, the cut flag cut and the recovered errors errs.

transitional op opr.attemptMissing(op Operator, f Frame, v Value, start int, cut bool, errs Errs, mark int) Attempt
  component operators
  reads env, pos, recovered
  features missing
  noreturn
  cost <= 0
  contract:
    // Is opr.attempt in a parse that can insert missing tokens: the match also holds a copy of the tokens
    // inserted after mark.

transitional op opr.replay(a Attempt)
  component recovered
  reads operators
  writes recovered
  features missing
  noreturn
  cost <= 0
  contract:
    // Records again the tokens that the match a inserted and the errors it recovered, as rec.add does for
    // the errors outside the missing-token mode.

transitional op opr.found(a Attempt) bool
  component operators
  cost <= 0
  contract:
    // Reports whether a is a match, not the null attempt.

transitional op opr.op(a Attempt) Operator
  component operators
  cost <= 0
  contract:
    // Returns the operator of the match a.
  requires:
    // opr.found(a).

transitional op opr.end(a Attempt) int
  component operators
  cost <= 0
  contract:
    // Returns where the match a ended.
  requires:
    // opr.found(a).

transitional op opr.cut(a Attempt) bool
  component operators
  cost <= 0
  contract:
    // Reports whether the match a cut.
  requires:
    // opr.found(a).

transitional op opr.env(a Attempt) Scope
  component operators
  cost <= 0
  contract:
    // Returns the variable environment after the match a.
  requires:
    // opr.found(a).

transitional op opr.errs(a Attempt) Errs
  component operators
  cost <= 0
  contract:
    // Returns the errors that the match a recovered.
  requires:
    // opr.found(a).

transitional op opr.setCutFailed(failed bool)
