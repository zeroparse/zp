## file action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$as1]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$a]), term.field([a of $a]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  let tm11 = term.kids()
  let ti12, tf12 = items(term.name([map]), term.read([$pkg]))
  if (tf12 != null(Fail)) {
    return null(Datum), tf12
  }
  let tj13 = 0
  loop each14 while (tj13 < seq.len(ti12)); post tj13 = (tj13 + 1) {
    seq.step()
    let tp15 = itemAt(ti12, tj13, false)
    let tv17, tf17 = member(term.ctx(), 4, val.unbox(tp15), term.name([$p]), term.field([p of $p]))
    if (tf17 != null(Fail)) {
      return null(Datum), tf17
    }
    let tv16 = tv17
    let tf18 = push(term.ctx(), term.name([map]), tv16)
    if (tf18 != null(Fail)) {
      return null(Datum), tf18
    }
  }
  let tk19 = term.elemsAbove(tm11)
  let tn20 = hull(term.ctx(), false, tk19)
  let tm21 = term.kids()
  let ti22, tf22 = items(term.name([map]), term.read([$as2]))
  if (tf22 != null(Fail)) {
    return null(Datum), tf22
  }
  let tj23 = 0
  loop each24 while (tj23 < seq.len(ti22)); post tj23 = (tj23 + 1) {
    seq.step()
    let tp25 = itemAt(ti22, tj23, false)
    let tv27, tf27 = member(term.ctx(), 4, val.unbox(tp25), term.name([$a]), term.field([a of $a]))
    if (tf27 != null(Fail)) {
      return null(Datum), tf27
    }
    let tv26 = tv27
    let tf28 = push(term.ctx(), term.name([map]), tv26)
    if (tf28 != null(Fail)) {
      return null(Datum), tf28
    }
  }
  let tk29 = term.elemsAbove(tm21)
  let tn30 = hull(term.ctx(), false, tk29)
  let tm31 = term.kids()
  let ti32, tf32 = items(term.name([map]), term.read([$is]))
  if (tf32 != null(Fail)) {
    return null(Datum), tf32
  }
  let tj33 = 0
  loop each34 while (tj33 < seq.len(ti32)); post tj33 = (tj33 + 1) {
    seq.step()
    let tp35 = itemAt(ti32, tj33, false)
    let tv37, tf37 = member(term.ctx(), 4, val.unbox(tp35), term.name([$i]), term.field([i of $i]))
    if (tf37 != null(Fail)) {
      return null(Datum), tf37
    }
    let tv36 = tv37
    let tf38 = push(term.ctx(), term.name([map]), tv36)
    if (tf38 != null(Fail)) {
      return null(Datum), tf38
    }
  }
  let tk39 = term.elemsAbove(tm31)
  let tn40 = hull(term.ctx(), false, tk39)
  let tm41 = term.kids()
  seq.step()
  let tf42 = pushItems(term.ctx(), term.name([concat]), term.fromObj(tn10))
  if (tf42 != null(Fail)) {
    return null(Datum), tf42
  }
  seq.step()
  let tf43 = pushItems(term.ctx(), term.name([concat]), term.fromObj(tn20))
  if (tf43 != null(Fail)) {
    return null(Datum), tf43
  }
  seq.step()
  let tf44 = pushItems(term.ctx(), term.name([concat]), term.fromObj(tn30))
  if (tf44 != null(Fail)) {
    return null(Datum), tf44
  }
  seq.step()
  let tf45 = pushItems(term.ctx(), term.name([concat]), term.fromObj(tn40))
  if (tf45 != null(Fail)) {
    return null(Datum), tf45
  }
  seq.step()
  let tf46 = pushItems(term.ctx(), term.name([concat]), term.read([$ds]))
  if (tf46 != null(Fail)) {
    return null(Datum), tf46
  }
  let tk47 = term.elemsAbove(tm41)
  let tn48 = hull(term.ctx(), false, tk47)
  let tf49 = term.fromObj(tn48)
  let tn50 = term.struct([File])
  let tfirst51 = true
  seq.step()
  term.setField([Decls], tn50, tf49)
  tfirst51 = cover(tn50, tf49, tfirst51)
  made(term.ctx(), tn50, tfirst51)
  return term.fromObj(tn50), null(Fail)
}

