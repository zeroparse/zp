## ml_open_tail predicate
func term() Datum {
  let tv1, tf1 = length(term.read([$xh]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = binary(5, tv1, term.const([0]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tb3, tf3 = logic(1, tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tv4 = val.fromBool(true)
  if !tb3 {
    let tv5, tf5 = length(term.read([$xh]))
    if (tf5 != null(Fail)) {
      term.raise(tf5)
    }
    let tv6 = term.read([var sv])
    let tv7, tf7 = binary(3, tv6, term.const([2]))
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    let tv8, tf8 = binary(7, tv5, tv7)
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let tb9, tf9 = logic(1, tv8)
    if (tf9 != null(Fail)) {
      term.raise(tf9)
    }
    tv4 = val.fromBool(tb9)
  }
  return tv4
}

