        }
        let tb18, tf18 = logic(0, tv17)
        if (tf18 != null(Fail)) {
          return null(Datum), tf18
        }
        tv14 = val.fromBool(tb18)
      }
      let tb19, tf19 = logic(1, tv14)
      if (tf19 != null(Fail)) {
        return null(Datum), tf19
      }
      let tv20 = val.fromBool(true)
      if !tb19 {
        let tv21, tf21 = member(term.ctx(), 4, val.unbox(tp6), term.name([$lead]), term.field([lead of $lead]))
        if (tf21 != null(Fail)) {
          return null(Datum), tf21
