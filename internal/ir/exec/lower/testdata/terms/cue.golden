      let tv14 = val.fromBool(false)
      if tb13 {
        let tv15, tf15 = member(term.ctx(), 4, val.unbox(tp6), term.name([$body]), term.field([body of $body]))
        if (tf15 != null(Fail)) {
          return null(Datum), tf15
        }
        let tv16, tf16 = length(tv15)
        if (tf16 != null(Fail)) {
