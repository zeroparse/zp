func term() (Datum, Fail) {
  let ti1, tf1 = items(term.name([foldl]), term.read([$ls]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ta2 = term.const([true])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, false)
    let tb8, tf8 = logic(0, val.unbox(tp5))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv9 = val.fromBool(false)
    if tb8 {
      let tv10, tf10 = member(term.ctx(), 4, val.unbox(tp6), term.name([$lead]), term.field([lead of $lead]))
      if (tf10 != null(Fail)) {
        return null(Datum), tf10
      }
      let tv11, tf11 = length(tv10)
      if (tf11 != null(Fail)) {
        return null(Datum), tf11
      }
      let tv12, tf12 = binary(5, tv11, term.const([0]))
      if (tf12 != null(Fail)) {
