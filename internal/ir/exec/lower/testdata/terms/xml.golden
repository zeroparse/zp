## pi predicate
func term() (Datum, Fail) {
  let ts1, tf1 = text(term.read([$t]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let tv2, tf2 = binary(6, term.fromStr(ts1), term.const(["xml"]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tb3, tf3 = logic(0, tv2)
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tv4 = val.fromBool(false)
  if tb3 {
    let ts5, tf5 = text(term.read([$t]))
    if (tf5 != null(Fail)) {
      return null(Datum), tf5
    }
    let tv6, tf6 = binary(6, term.fromStr(ts5), term.const(["xmL"]))
    if (tf6 != null(Fail)) {
      return null(Datum), tf6
    }
    let tb7, tf7 = logic(0, tv6)
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    tv4 = val.fromBool(tb7)
  }
  let tb8, tf8 = logic(0, tv4)
  if (tf8 != null(Fail)) {
    return null(Datum), tf8
  }
  let tv9 = val.fromBool(false)
  if tb8 {
    let ts10, tf10 = text(term.read([$t]))
    if (tf10 != null(Fail)) {
      return null(Datum), tf10
    }
    let tv11, tf11 = binary(6, term.fromStr(ts10), term.const(["xMl"]))
    if (tf11 != null(Fail)) {
      return null(Datum), tf11
    }
    let tb12, tf12 = logic(0, tv11)
    if (tf12 != null(Fail)) {
      return null(Datum), tf12
    }
    tv9 = val.fromBool(tb12)
  }
  let tb13, tf13 = logic(0, tv9)
  if (tf13 != null(Fail)) {
    return null(Datum), tf13
  }
  let tv14 = val.fromBool(false)
  if tb13 {
