## main action
func term() Datum {
  let tf1 = term.read([$d])
  let tm3 = term.kids()
  seq.step()
  let tf4 = pushItems(term.ctx(), term.name([concat]), term.read([$p1]))
  if (tf4 != null(Fail)) {
    term.raise(tf4)
  }
  seq.step()
  let tf5 = pushItems(term.ctx(), term.name([concat]), term.read([$p2]))
  if (tf5 != null(Fail)) {
    term.raise(tf5)
  }
  let tk6 = term.elemsAbove(tm3)
  let tn7 = hull(term.ctx(), false, tk6)
  let tf2 = term.fromObj(tn7)
  let tf8 = term.read([$dt])
  let tf9 = term.read([$r])
  let tf10 = term.read([$e])
  let tn11 = term.struct([Document])
  let tfirst12 = true
  seq.step()
  term.setField([Decl], tn11, tf1)
  tfirst12 = cover(tn11, tf1, tfirst12)
  seq.step()
  term.setField([Prolog], tn11, tf2)
  tfirst12 = cover(tn11, tf2, tfirst12)
  seq.step()
  term.setField([Doctype], tn11, tf8)
  tfirst12 = cover(tn11, tf8, tfirst12)
  seq.step()
  term.setField([Root], tn11, tf9)
  tfirst12 = cover(tn11, tf9, tfirst12)
  seq.step()
  term.setField([Epilog], tn11, tf10)
  tfirst12 = cover(tn11, tf10, tfirst12)
  made(term.ctx(), tn11, tfirst12)
  return term.fromObj(tn11)
}

