## pi predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$t]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = binary(6, term.fromStr(ts1), term.const(["xml"]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tb3, tf3 = logic(0, tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tv4 = val.fromBool(false)
  if tb3 {
    let ts5, tf5 = text(term.read([$t]))
    if (tf5 != null(Fail)) {
      term.raise(tf5)
    }
    let tv6, tf6 = binary(6, term.fromStr(ts5), term.const(["xmL"]))
    if (tf6 != null(Fail)) {
      term.raise(tf6)
    }
    let tb7, tf7 = logic(0, tv6)
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    tv4 = val.fromBool(tb7)
  }
  let tb8, tf8 = logic(0, tv4)
  if (tf8 != null(Fail)) {
    term.raise(tf8)
  }
  let tv9 = val.fromBool(false)
  if tb8 {
    let ts10, tf10 = text(term.read([$t]))
    if (tf10 != null(Fail)) {
      term.raise(tf10)
    }
    let tv11, tf11 = binary(6, term.fromStr(ts10), term.const(["xMl"]))
    if (tf11 != null(Fail)) {
      term.raise(tf11)
    }
    let tb12, tf12 = logic(0, tv11)
    if (tf12 != null(Fail)) {
      term.raise(tf12)
    }
    tv9 = val.fromBool(tb12)
  }
  let tb13, tf13 = logic(0, tv9)
  if (tf13 != null(Fail)) {
    term.raise(tf13)
  }
  let tv14 = val.fromBool(false)
  if tb13 {
    let ts15, tf15 = text(term.read([$t]))
    if (tf15 != null(Fail)) {
      term.raise(tf15)
    }
    let tv16, tf16 = binary(6, term.fromStr(ts15), term.const(["xML"]))
    if (tf16 != null(Fail)) {
      term.raise(tf16)
    }
    let tb17, tf17 = logic(0, tv16)
    if (tf17 != null(Fail)) {
      term.raise(tf17)
    }
    tv14 = val.fromBool(tb17)
  }
  let tb18, tf18 = logic(0, tv14)
  if (tf18 != null(Fail)) {
    term.raise(tf18)
  }
  let tv19 = val.fromBool(false)
  if tb18 {
    let ts20, tf20 = text(term.read([$t]))
