## main action
func term() Datum {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(term.ctx(), term.name([concat]), term.read([$p1]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  seq.step()
  let tf3 = pushItems(term.ctx(), term.name([concat]), term.read([$p2]))
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tk4 = term.elemsAbove(tm1)
  let tn5 = hull(term.ctx(), false, tk4)
  let tn6 = term.struct([Document])
  let tfirst7 = true
  seq.step()
  term.setField([Decl], tn6, term.read([$d]))
  tfirst7 = cover(tn6, term.read([$d]), tfirst7)
  seq.step()
  term.setField([Prolog], tn6, term.fromObj(tn5))
  tfirst7 = cover(tn6, term.fromObj(tn5), tfirst7)
  seq.step()
  term.setField([Doctype], tn6, term.read([$dt]))
  tfirst7 = cover(tn6, term.read([$dt]), tfirst7)
  seq.step()
  term.setField([Root], tn6, term.read([$r]))
  tfirst7 = cover(tn6, term.read([$r]), tfirst7)
  seq.step()
  term.setField([Epilog], tn6, term.read([$e]))
  tfirst7 = cover(tn6, term.read([$e]), tfirst7)
  made(term.ctx(), tn6, tfirst7)
  return term.fromObj(tn6)
}

## misc_list action
func term() Datum {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$ms]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$m]), term.field([m of $m]))
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  return term.fromObj(tn10)
}

