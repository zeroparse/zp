## main action
func term() (Datum, Fail) {
  let tf1 = term.read([$d])
  let tm2 = term.kids()
  seq.step()
  let tf3 = pushItems(term.ctx(), term.name([concat]), term.read([$p1]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  seq.step()
  let tf4 = pushItems(term.ctx(), term.name([concat]), term.read([$p2]))
  if (tf4 != null(Fail)) {
    return null(Datum), tf4
  }
  let tk5 = term.elemsAbove(tm2)
  let tn6 = hull(term.ctx(), false, tk5)
  let tf7 = term.fromObj(tn6)
  let tf8 = term.read([$dt])
  let tf9 = term.read([$r])
  let tf10 = term.read([$e])
  let tn11 = term.struct([Document])
  let tfirst12 = true
  seq.step()
  term.setField([Decl], tn11, tf1)
  tfirst12 = cover(tn11, tf1, tfirst12)
  seq.step()
  term.setField([Prolog], tn11, tf7)
  tfirst12 = cover(tn11, tf7, tfirst12)
  seq.step()
  term.setField([Doctype], tn11, tf8)
  tfirst12 = cover(tn11, tf8, tfirst12)
  seq.step()
  term.setField([Root], tn11, tf9)
  tfirst12 = cover(tn11, tf9, tfirst12)
  seq.step()
  term.setField([Epilog], tn11, tf10)
  tfirst12 = cover(tn11, tf10, tfirst12)
  made(term.ctx(), tn11, tfirst12)
  return term.fromObj(tn11), null(Fail)
}

## misc_list action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$ms]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$m]), term.field([m of $m]))
    if (tf7 != null(Fail)) {
