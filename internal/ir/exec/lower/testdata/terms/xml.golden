  seq.step()
  term.setField([Parameter], tn1, term.const([true]))
  tfirst2 = cover(tn1, term.const([true]), tfirst2)
  seq.step()
  term.setField([Name], tn1, term.read([$n]))
  tfirst2 = cover(tn1, term.read([$n]), tfirst2)
  seq.step()
  term.setField([Value], tn1, term.read([$v]))
  tfirst2 = cover(tn1, term.read([$v]), tfirst2)
  seq.step()
  term.setField([ExternalID], tn1, term.read([$x]))
  tfirst2 = cover(tn1, term.read([$x]), tfirst2)
  made(term.ctx(), tn1, tfirst2)
  return term.fromObj(tn1)
}

## entity_value action
func term() Datum {
  return term.read([$v])
}

