## element predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$e]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let ts2, tf2 = text(term.read([$n]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  return val.fromBool(term.textEqual(ts1, ts2))
}

