## element action
func term() (Datum, Fail) {
  let tf1 = term.read([$n])
  let tm2 = term.kids()
  let ti3, tf3 = items(term.name([map]), term.read([$as]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$a]), term.field([a of $a]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(term.ctx(), term.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = term.elemsAbove(tm2)
  let tn11 = hull(term.ctx(), false, tk10)
  let tf12 = term.fromObj(tn11)
  let tm13 = term.kids()
  seq.step()
  let tf14 = pushItems(term.ctx(), term.name([concat]), term.read([$cs]))
  if (tf14 != null(Fail)) {
    return null(Datum), tf14
  }
  let tk15 = term.elemsAbove(tm13)
  let tn16 = hull(term.ctx(), false, tk15)
  let tf17 = term.fromObj(tn16)
  let tn18 = term.struct([Element])
  let tfirst19 = true
  seq.step()
  term.setField([Name], tn18, tf1)
  tfirst19 = cover(tn18, tf1, tfirst19)
  seq.step()
  term.setField([Attrs], tn18, tf12)
  tfirst19 = cover(tn18, tf12, tfirst19)
  seq.step()
  term.setField([Content], tn18, tf17)
  tfirst19 = cover(tn18, tf17, tfirst19)
  made(term.ctx(), tn18, tfirst19)
  return term.fromObj(tn18), null(Fail)
}

## element predicate
func term() (Datum, Fail) {
  let ts1, tf1 = text(term.read([$e]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ts2, tf2 = text(term.read([$n]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  return val.fromBool(term.textEqual(ts1, ts2)), null(Fail)
}

