## element action
func term() Datum {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$as]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$a]), term.field([a of $a]))
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  let tm11 = term.kids()
  seq.step()
  let tf12 = pushItems(term.ctx(), term.name([concat]), term.read([$cs]))
  if (tf12 != null(Fail)) {
    term.raise(tf12)
  }
  let tk13 = term.elemsAbove(tm11)
  let tn14 = hull(term.ctx(), false, tk13)
  let tn15 = term.struct([Element])
  let tfirst16 = true
  seq.step()
  term.setField([Name], tn15, term.read([$n]))
  tfirst16 = cover(tn15, term.read([$n]), tfirst16)
  seq.step()
  term.setField([Attrs], tn15, term.fromObj(tn10))
  tfirst16 = cover(tn15, term.fromObj(tn10), tfirst16)
  seq.step()
  term.setField([Content], tn15, term.fromObj(tn14))
  tfirst16 = cover(tn15, term.fromObj(tn14), tfirst16)
  made(term.ctx(), tn15, tfirst16)
  return term.fromObj(tn15)
}

## element predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$e]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let ts2, tf2 = text(term.read([$n]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  return val.fromBool(term.textEqual(ts1, ts2))
}

