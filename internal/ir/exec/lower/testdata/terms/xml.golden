    return null(Datum), tf18
  }
  let tv19 = val.fromBool(false)
  if tb18 {
    let ts20, tf20 = text(term.read([$t]))
    if (tf20 != null(Fail)) {
      return null(Datum), tf20
    }
    let tv21, tf21 = binary(6, term.fromStr(ts20), term.const(["Xml"]))
    if (tf21 != null(Fail)) {
      return null(Datum), tf21
    }
    let tb22, tf22 = logic(0, tv21)
    if (tf22 != null(Fail)) {
      return null(Datum), tf22
    }
    tv19 = val.fromBool(tb22)
  }
  let tb23, tf23 = logic(0, tv19)
  if (tf23 != null(Fail)) {
    return null(Datum), tf23
  }
  let tv24 = val.fromBool(false)
  if tb23 {
    let ts25, tf25 = text(term.read([$t]))
    if (tf25 != null(Fail)) {
      return null(Datum), tf25
    }
    let tv26, tf26 = binary(6, term.fromStr(ts25), term.const(["XmL"]))
    if (tf26 != null(Fail)) {
      return null(Datum), tf26
    }
    let tb27, tf27 = logic(0, tv26)
    if (tf27 != null(Fail)) {
      return null(Datum), tf27
    }
    tv24 = val.fromBool(tb27)
  }
  let tb28, tf28 = logic(0, tv24)
  if (tf28 != null(Fail)) {
    return null(Datum), tf28
  }
  let tv29 = val.fromBool(false)
  if tb28 {
    let ts30, tf30 = text(term.read([$t]))
    if (tf30 != null(Fail)) {
      return null(Datum), tf30
    }
    let tv31, tf31 = binary(6, term.fromStr(ts30), term.const(["XMl"]))
    if (tf31 != null(Fail)) {
