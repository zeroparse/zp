## not_unary action
func term(c Act) (Datum, Fail) {
  let ti1, tf1 = items(term.name([foldr]), term.read([$ops]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ta2 = term.read([$m])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, true)
    let tv8, tf8 = member(c, 4, val.unbox(tp6), term.name([$o]), term.field([o of $o]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tf9 = val.unbox(tp5)
    let tn10 = term.struct([Unary])
    let tfirst11 = true
    seq.step()
    term.setField([Op], tn10, tv8)
    tfirst11 = cover(tn10, tv8, tfirst11)
    seq.step()
    term.setField([X], tn10, tf9)
    tfirst11 = cover(tn10, tf9, tfirst11)
    made(c, tn10, tfirst11)
    let tv7 = term.fromObj(tn10)
    ta2 = tv7
  }
  return ta2, null(Fail)
}

