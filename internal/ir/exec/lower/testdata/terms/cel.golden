## not_unary action
func term() Datum {
  let ti1, tf1 = items(term.name([foldr]), term.read([$ops]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let ta2 = term.read([$m])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, true)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$o]), term.field([o of $o]))
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let tn9 = term.struct([Unary])
    let tfirst10 = true
    seq.step()
    term.setField([Op], tn9, tv8)
    tfirst10 = cover(tn9, tv8, tfirst10)
    seq.step()
    term.setField([X], tn9, val.unbox(tp5))
    tfirst10 = cover(tn9, val.unbox(tp5), tfirst10)
    made(term.ctx(), tn9, tfirst10)
    let tv7 = term.fromObj(tn9)
    ta2 = tv7
  }
  return ta2
}

