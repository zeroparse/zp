func term() Datum {
  let tf1 = term.read([$lhs])
  let tf2 = term.read([$then])
  let tf3 = term.read([$rhs])
  let tn4 = term.struct([Conditional])
  let tfirst5 = true
  seq.step()
  term.setField([Cond], tn4, tf1)
  tfirst5 = cover(tn4, tf1, tfirst5)
  seq.step()
  term.setField([Then], tn4, tf2)
  tfirst5 = cover(tn4, tf2, tfirst5)
  seq.step()
  term.setField([Else], tn4, tf3)
  tfirst5 = cover(tn4, tf3, tfirst5)
  made(term.ctx(), tn4, tfirst5)
  return term.fromObj(tn4)
}

