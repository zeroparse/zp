func term() Datum {
  let tv1, tf1 = length(term.read([$q]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = binary(9, tv1, term.const([0]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tn3 = term.struct([Select])
  let tfirst4 = true
  seq.step()
  term.setField([X], tn3, term.read([$lhs]))
  tfirst4 = cover(tn3, term.read([$lhs]), tfirst4)
  seq.step()
  term.setField([Field], tn3, term.read([$f]))
  tfirst4 = cover(tn3, term.read([$f]), tfirst4)
  seq.step()
  term.setField([Optional], tn3, tv2)
  tfirst4 = cover(tn3, tv2, tfirst4)
  made(term.ctx(), tn3, tfirst4)
  return term.fromObj(tn3)
}

