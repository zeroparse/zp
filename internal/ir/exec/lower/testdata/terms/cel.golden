## expr line 2
func term() Datum {
  let tn1 = term.struct([Conditional])
  let tfirst2 = true
  seq.step()
  term.setField([Cond], tn1, term.read([$lhs]))
  tfirst2 = cover(tn1, term.read([$lhs]), tfirst2)
  seq.step()
  term.setField([Then], tn1, term.read([$then]))
  tfirst2 = cover(tn1, term.read([$then]), tfirst2)
  seq.step()
  term.setField([Else], tn1, term.read([$rhs]))
  tfirst2 = cover(tn1, term.read([$rhs]), tfirst2)
  made(term.ctx(), tn1, tfirst2)
  return term.fromObj(tn1)
}

