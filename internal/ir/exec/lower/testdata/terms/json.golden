## main action
func term(c Act) (Datum, Fail) {
  return term.read([$v]), null(Fail)
}

## object action
func term(c Act) (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(c, term.name([concat]), term.read([$ms]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(c, false, tk3)
  let tf5 = term.fromObj(tn4)
  let tn6 = term.struct([Object])
  let tfirst7 = true
  seq.step()
  term.setField([Members], tn6, tf5)
  tfirst7 = cover(tn6, tf5, tfirst7)
  made(c, tn6, tfirst7)
  return term.fromObj(tn6), null(Fail)
}

## members action
func term(c Act) (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = push(c, term.name([list]), term.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(term.name([map]), term.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(c, 4, val.unbox(tp6), term.name([$m]), term.field([m of $m]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(c, term.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = term.elemsAbove(tm1)
  let tn11 = hull(c, false, tk10)
  return term.fromObj(tn11), null(Fail)
}

## member action
func term(c Act) (Datum, Fail) {
  let tf1 = term.read([$k])
  let tf2 = term.read([$v])
  let tn3 = term.struct([Member])
  let tfirst4 = true
  seq.step()
  term.setField([Key], tn3, tf1)
  tfirst4 = cover(tn3, tf1, tfirst4)
  seq.step()
  term.setField([Value], tn3, tf2)
  tfirst4 = cover(tn3, tf2, tfirst4)
  made(c, tn3, tfirst4)
  return term.fromObj(tn3), null(Fail)
}

