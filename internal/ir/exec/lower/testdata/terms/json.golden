    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(c, 4, val.unbox(tp6), term.name([$v]), term.field([v of $v]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
