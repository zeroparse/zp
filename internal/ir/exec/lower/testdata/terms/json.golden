}

## elements action
func term(c Act) (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = push(c, term.name([list]), term.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
