## main action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$is]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$d]), term.field([d of $d]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let ti9, tf9 = items(term.name([map]), term.read([$ds]))
  if (tf9 != null(Fail)) {
    return null(Datum), tf9
  }
  let tj10 = 0
  loop each11 while (tj10 < seq.len(ti9)); post tj10 = (tj10 + 1) {
    seq.step()
    let tp12 = itemAt(ti9, tj10, false)
    let tv14, tf14 = member(term.ctx(), 4, val.unbox(tp12), term.name([$d]), term.field([d of $d]))
    if (tf14 != null(Fail)) {
      return null(Datum), tf14
    }
    let tv13 = tv14
    let tf15 = push(term.ctx(), term.name([map]), tv13)
    if (tf15 != null(Fail)) {
      return null(Datum), tf15
    }
  }
  let tk16 = term.elemsAbove(tm1)
  let tn17 = hull(term.ctx(), false, tk16)
  let tn18 = term.struct([File])
  let tfirst19 = true
  seq.step()
  term.setField([Name], tn18, term.read([$n]))
  tfirst19 = cover(tn18, term.read([$n]), tfirst19)
  seq.step()
  term.setField([Decls], tn18, term.fromObj(tn17))
  tfirst19 = cover(tn18, term.fromObj(tn17), tfirst19)
  made(term.ctx(), tn18, tfirst19)
  return term.fromObj(tn18), null(Fail)
}

