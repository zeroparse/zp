    }
    let tn9 = term.struct([BinaryExpr])
    let tfirst10 = true
    seq.step()
    term.setField([X], tn9, val.unbox(tp5))
    tfirst10 = cover(tn9, val.unbox(tp5), tfirst10)
    seq.step()
    term.setField([Op], tn9, term.const(["|"]))
    tfirst10 = cover(tn9, term.const(["|"]), tfirst10)
    seq.step()
    term.setField([Y], tn9, tv8)
    tfirst10 = cover(tn9, tv8, tfirst10)
    made(term.ctx(), tn9, tfirst10)
    let tv7 = term.fromObj(tn9)
    ta2 = tv7
  }
  return ta2, null(Fail)
}

