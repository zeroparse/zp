## main action
func term() (Datum, Fail) {
  let tf1 = term.read([$n])
  let tm2 = term.kids()
  let ti3, tf3 = items(term.name([map]), term.read([$is]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$d]), term.field([d of $d]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(term.ctx(), term.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let ti10, tf10 = items(term.name([map]), term.read([$ds]))
  if (tf10 != null(Fail)) {
    return null(Datum), tf10
  }
  let tj11 = 0
  loop each12 while (tj11 < seq.len(ti10)); post tj11 = (tj11 + 1) {
    seq.step()
    let tp13 = itemAt(ti10, tj11, false)
    let tv15, tf15 = member(term.ctx(), 4, val.unbox(tp13), term.name([$d]), term.field([d of $d]))
    if (tf15 != null(Fail)) {
      return null(Datum), tf15
    }
    let tv14 = tv15
    let tf16 = push(term.ctx(), term.name([map]), tv14)
    if (tf16 != null(Fail)) {
      return null(Datum), tf16
    }
  }
  let tk17 = term.elemsAbove(tm2)
  let tn18 = hull(term.ctx(), false, tk17)
  let tf19 = term.fromObj(tn18)
  let tn20 = term.struct([File])
  let tfirst21 = true
  seq.step()
  term.setField([Name], tn20, tf1)
  tfirst21 = cover(tn20, tf1, tfirst21)
  seq.step()
  term.setField([Decls], tn20, tf19)
  tfirst21 = cover(tn20, tf19, tfirst21)
  made(term.ctx(), tn20, tfirst21)
  return term.fromObj(tn20), null(Fail)
}

