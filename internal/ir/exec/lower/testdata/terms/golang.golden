    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$t]), term.field([t of $t]))
    if (tf8 != null(Fail)) {
