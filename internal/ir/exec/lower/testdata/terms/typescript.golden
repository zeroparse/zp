## sourceFile action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$ss]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$s]), term.field([s of $s]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  let tf11 = term.fromObj(tn10)
  let tf12 = term.read([$e])
  let tn13 = term.struct([SourceFile])
  let tfirst14 = true
  seq.step()
  term.setField([Statements], tn13, tf11)
  tfirst14 = cover(tn13, tf11, tfirst14)
  seq.step()
  term.setField([EndOfFileToken], tn13, tf12)
  tfirst14 = cover(tn13, tf12, tfirst14)
  made(term.ctx(), tn13, tfirst14)
  return term.fromObj(tn13), null(Fail)
}

