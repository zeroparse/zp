## tryStatement action
func term() (Datum, Fail) {
  let tf1 = term.read([$b])
  let tf2 = term.read([$cc])
  let tf3 = term.read([$fb])
  let tn4 = term.struct([TryStatement])
  let tfirst5 = true
  seq.step()
  term.setField([TryBlock], tn4, tf1)
  tfirst5 = cover(tn4, tf1, tfirst5)
  seq.step()
  term.setField([CatchClause], tn4, tf2)
  tfirst5 = cover(tn4, tf2, tfirst5)
  seq.step()
  term.setField([FinallyBlock], tn4, tf3)
