## tryStatement predicate
func term() (Datum, Fail) {
  let tv1, tf1 = binary(6, term.read([$cc]), term.const([<nil>]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let tb2, tf2 = logic(1, tv1)
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tv3 = val.fromBool(true)
  if !tb2 {
    let tv4, tf4 = binary(6, term.read([$fb]), term.const([<nil>]))
    if (tf4 != null(Fail)) {
      return null(Datum), tf4
    }
    let tb5, tf5 = logic(1, tv4)
    if (tf5 != null(Fail)) {
      return null(Datum), tf5
    }
    tv3 = val.fromBool(tb5)
  }
  return tv3, null(Fail)
}

