## sourceFile action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$ss]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$s]), term.field([s of $s]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  let tn11 = term.struct([SourceFile])
  let tfirst12 = true
  seq.step()
  term.setField([Statements], tn11, term.fromObj(tn10))
  tfirst12 = cover(tn11, term.fromObj(tn10), tfirst12)
  seq.step()
  term.setField([EndOfFileToken], tn11, term.read([$e]))
  tfirst12 = cover(tn11, term.read([$e]), tfirst12)
  made(term.ctx(), tn11, tfirst12)
  return term.fromObj(tn11), null(Fail)
}

