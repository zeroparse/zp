## conditional action
func term() Datum {
  let ti1, tf1 = items(term.name([foldl]), term.read([$t]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let ta2 = term.read([$d])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$c]), term.field([c of $c]))
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let tv9, tf9 = member(term.ctx(), 4, val.unbox(tp6), term.name([$o]), term.field([o of $o]))
    if (tf9 != null(Fail)) {
      term.raise(tf9)
    }
    let tn10 = term.struct([IfExp])
    let tfirst11 = true
    seq.step()
    term.setField([Test], tn10, tv8)
    tfirst11 = cover(tn10, tv8, tfirst11)
    seq.step()
    term.setField([Body], tn10, term.read([$d]))
    tfirst11 = cover(tn10, term.read([$d]), tfirst11)
    seq.step()
    term.setField([OrElse], tn10, tv9)
    tfirst11 = cover(tn10, tv9, tfirst11)
    made(term.ctx(), tn10, tfirst11)
    let tv7 = term.fromObj(tn10)
    ta2 = tv7
  }
  return ta2
}

