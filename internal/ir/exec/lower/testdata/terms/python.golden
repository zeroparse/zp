    }
    let tv11, tf11 = binary(0, val.unbox(tp6), tv10)
    if (tf11 != null(Fail)) {
      return null(Datum), tf11
    }
    let tv12, tf12 = binary(3, tv11, term.const([8]))
    if (tf12 != null(Fail)) {
      return null(Datum), tf12
    }
    let tv13, tf13 = binary(2, tv12, term.const([8]))
    if (tf13 != null(Fail)) {
