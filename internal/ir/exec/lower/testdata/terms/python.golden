  let ti1, tf1 = items(term.name([foldl]), term.read([$r]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let ta2 = term.read([$f])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$n]), term.field([n of $n]))
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let ts9, tf9 = text(tv8)
    if (tf9 != null(Fail)) {
      term.raise(tf9)
    }
    let tn10 = term.struct([Attribute])
    let tfirst11 = true
    seq.step()
    term.setField([Value], tn10, val.unbox(tp5))
    tfirst11 = cover(tn10, val.unbox(tp5), tfirst11)
    seq.step()
    term.setField([Attr], tn10, term.fromStr(ts9))
    tfirst11 = cover(tn10, term.fromStr(ts9), tfirst11)
    seq.step()
    term.setField([Ctx], tn10, term.const(["Load"]))
    tfirst11 = cover(tn10, term.const(["Load"]), tfirst11)
    made(term.ctx(), tn10, tfirst11)
    let tv7 = term.fromObj(tn10)
    ta2 = tv7
  }
  return ta2
}

