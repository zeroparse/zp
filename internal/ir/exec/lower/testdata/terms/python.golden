    }
    let ta23 = term.const([0])
    let tj24 = 0
    loop each25 while (tj24 < seq.len(ti22)); post tj24 = (tj24 + 1) {
      seq.step()
      let tp26 = ta23
      let tp27 = itemAt(ti22, tj24, false)
      let tv29, tf29 = member(c, 4, val.unbox(tp27), term.name([$sp]), term.field([sp of $sp]))
      if (tf29 != null(Fail)) {
        return null(Datum), tf29
      }
      let tv30, tf30 = length(tv29)
      if (tf30 != null(Fail)) {
        return null(Datum), tf30
      }
      let tv31, tf31 = binary(0, val.unbox(tp26), tv30)
      if (tf31 != null(Fail)) {
        return null(Datum), tf31
      }
      let tv32, tf32 = binary(0, tv31, term.const([1]))
      if (tf32 != null(Fail)) {
        return null(Datum), tf32
      }
      let tv28 = tv32
      ta23 = tv28
    }
    let tv33, tf33 = member(c, 4, term.read([$i]), term.name([$tail]), term.field([tail of $tail]))
    if (tf33 != null(Fail)) {
