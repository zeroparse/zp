    }
    let tv14, tf14 = binary(0, tv13, term.const([8]))
    if (tf14 != null(Fail)) {
      return null(Datum), tf14
    }
    let tv8 = tv14
    ta3 = tv8
  }
  let tv15, tf15 = member(c, 4, term.read([$i]), term.name([$tail]), term.field([tail of $tail]))
  if (tf15 != null(Fail)) {
    return null(Datum), tf15
  }
  let tv16, tf16 = length(tv15)
  if (tf16 != null(Fail)) {
    return null(Datum), tf16
  }
  let tv17, tf17 = binary(0, ta3, tv16)
  if (tf17 != null(Fail)) {
    return null(Datum), tf17
  }
  let tv18, tf18 = binary(5, tv17, term.const([0]))
  if (tf18 != null(Fail)) {
    return null(Datum), tf18
  }
  let tb19, tf19 = logic(0, tv18)
  if (tf19 != null(Fail)) {
    return null(Datum), tf19
  }
  let tv20 = val.fromBool(false)
  if tb19 {
    let tv21, tf21 = member(c, 4, term.read([$i]), term.name([$segs]), term.field([segs of $segs]))
    if (tf21 != null(Fail)) {
      return null(Datum), tf21
    }
