## first_stmts predicate
func term(c Act) (Datum, Fail) {
  let tv1, tf1 = member(c, 4, term.read([$i]), term.name([$segs]), term.field([segs of $segs]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ti2, tf2 = items(term.name([foldl]), tv1)
  if (tf2 != null(Fail)) {
