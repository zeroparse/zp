## main action
func term() Datum {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(term.ctx(), term.name([concat]), term.read([$b]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(term.ctx(), false, tk3)
  let tn5 = term.struct([Module])
  let tfirst6 = true
  seq.step()
  term.setField([Body], tn5, term.fromObj(tn4))
  tfirst6 = cover(tn5, term.fromObj(tn4), tfirst6)
  made(term.ctx(), tn5, tfirst6)
  return term.fromObj(tn5)
}

