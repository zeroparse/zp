  }
  let ta3 = term.const([0])
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti2)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = ta3
    let tp7 = itemAt(ti2, tj4, false)
    let tv9, tf9 = member(c, 4, val.unbox(tp7), term.name([$sp]), term.field([sp of $sp]))
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
    let tv10, tf10 = length(tv9)
    if (tf10 != null(Fail)) {
