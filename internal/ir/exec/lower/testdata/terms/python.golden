## from_stmt predicate
func term() Datum {
  let tv1, tf1 = length(term.read([$ds]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = binary(9, tv1, term.const([0]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tb3, tf3 = logic(1, tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tv4 = val.fromBool(true)
  if !tb3 {
    let tv5, tf5 = member(term.ctx(), 4, term.read([$m]), term.name([$f]), term.name([f]))
    if (tf5 != null(Fail)) {
      term.raise(tf5)
    }
    let tv6, tf6 = binary(6, tv5, term.const([<nil>]))
    if (tf6 != null(Fail)) {
      term.raise(tf6)
    }
    let tb7, tf7 = logic(1, tv6)
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    tv4 = val.fromBool(tb7)
  }
  return tv4
}

