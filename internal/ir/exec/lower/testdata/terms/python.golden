## lambda_params predicate
func term() Datum {
  let tv1, tf1 = length(term.read([$sl]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = binary(5, tv1, term.const([0]))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tb3, tf3 = logic(1, tv2)
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tv4 = val.fromBool(true)
  if !tb3 {
    let tv5, tf5 = length(term.read([$g1nd]))
    if (tf5 != null(Fail)) {
      term.raise(tf5)
    }
    let tv6, tf6 = length(term.read([$g1wd]))
    if (tf6 != null(Fail)) {
      term.raise(tf6)
    }
    let tv7, tf7 = binary(0, tv5, tv6)
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    let tv8, tf8 = binary(9, tv7, term.const([0]))
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let tb9, tf9 = logic(1, tv8)
    if (tf9 != null(Fail)) {
      term.raise(tf9)
    }
    tv4 = val.fromBool(tb9)
  }
  return tv4
}

