## main action
func term(c Act) (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = pushItems(c, term.name([concat]), term.read([$b]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = term.elemsAbove(tm1)
  let tn4 = hull(c, false, tk3)
  let tf5 = term.fromObj(tn4)
  let tn6 = term.struct([Module])
  let tfirst7 = true
  seq.step()
  term.setField([Body], tn6, tf5)
  tfirst7 = cover(tn6, tf5, tfirst7)
  made(c, tn6, tfirst7)
  return term.fromObj(tn6), null(Fail)
}

