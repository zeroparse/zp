## iconst predicate
func term() Datum {
  let ts1, tf1 = text(term.read([$i]))
  if (tf1 != null(Fail)) {
    term.raise(tf1)
  }
  let tv2, tf2 = length(term.fromStr(ts1))
  if (tf2 != null(Fail)) {
    term.raise(tf2)
  }
  let tv3, tf3 = binary(7, tv2, term.const([10]))
  if (tf3 != null(Fail)) {
    term.raise(tf3)
  }
  let tb4, tf4 = logic(1, tv3)
  if (tf4 != null(Fail)) {
    term.raise(tf4)
  }
  let tv5 = val.fromBool(true)
  if !tb4 {
    let ts6, tf6 = text(term.read([$i]))
    if (tf6 != null(Fail)) {
      term.raise(tf6)
    }
    let tv7, tf7 = length(term.fromStr(ts6))
    if (tf7 != null(Fail)) {
      term.raise(tf7)
    }
    let tv8, tf8 = binary(5, tv7, term.const([10]))
    if (tf8 != null(Fail)) {
      term.raise(tf8)
    }
    let tb9, tf9 = logic(0, tv8)
    if (tf9 != null(Fail)) {
      term.raise(tf9)
    }
    let tv10 = val.fromBool(false)
    if tb9 {
      let ts11, tf11 = text(term.read([$i]))
      if (tf11 != null(Fail)) {
        term.raise(tf11)
      }
      let tv12, tf12 = binary(8, term.fromStr(ts11), term.const(["2147483647"]))
      if (tf12 != null(Fail)) {
        term.raise(tf12)
      }
      let tb13, tf13 = logic(0, tv12)
      if (tf13 != null(Fail)) {
        term.raise(tf13)
      }
      tv10 = val.fromBool(tb13)
    }
    let tb14, tf14 = logic(1, tv10)
    if (tf14 != null(Fail)) {
      term.raise(tf14)
    }
    tv5 = val.fromBool(tb14)
  }
  return tv5
}

