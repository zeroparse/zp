## main action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$rest]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(term.ctx(), 4, val.unbox(tp5), term.name([$s]), term.field([s of $s]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(term.ctx(), term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(term.ctx(), false, tk9)
  let tm11 = term.kids()
  seq.step()
  let tf12 = pushItems(term.ctx(), term.name([concat]), term.read([$first]))
  if (tf12 != null(Fail)) {
    return null(Datum), tf12
  }
  seq.step()
  let tf13 = pushItems(term.ctx(), term.name([concat]), term.fromObj(tn10))
  if (tf13 != null(Fail)) {
    return null(Datum), tf13
  }
  let tk14 = term.elemsAbove(tm11)
  let tn15 = hull(term.ctx(), false, tk14)
  let tf16 = term.fromObj(tn15)
  let tn17 = term.struct([Script])
  let tfirst18 = true
  seq.step()
  term.setField([Statements], tn17, tf16)
  tfirst18 = cover(tn17, tf16, tfirst18)
  made(term.ctx(), tn17, tfirst18)
  return term.fromObj(tn17), null(Fail)
}

