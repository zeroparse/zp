## qn_dotted action
func term() (Datum, Fail) {
  let tm1 = term.kids()
  seq.step()
  let tf2 = push(term.ctx(), term.name([list]), term.read([$p]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(term.name([map]), term.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(term.ctx(), 4, val.unbox(tp6), term.name([$a]), term.field([a of $a]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(term.ctx(), term.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = term.elemsAbove(tm1)
  let tn11 = hull(term.ctx(), false, tk10)
  let tf12 = term.fromObj(tn11)
  let tn13 = term.struct([Name])
  let tfirst14 = true
  seq.step()
  term.setField([Parts], tn13, tf12)
  tfirst14 = cover(tn13, tf12, tfirst14)
  made(term.ctx(), tn13, tfirst14)
  return term.fromObj(tn13), null(Fail)
}

