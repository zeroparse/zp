  let tb3, tf3 = logic(1, tv2)
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tv4 = val.fromBool(true)
  if !tb3 {
    let tv5 = term.read([var c])
    let tv6, tf6 = binary(5, tv5, term.const(["flow-key"]))
    if (tf6 != null(Fail)) {
      return null(Datum), tf6
    }
    let tb7, tf7 = logic(1, tv6)
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    tv4 = val.fromBool(tb7)
  }
  return tv4, null(Fail)
}

## s_flow_line_prefix predicate
func term(c Act) (Datum, Fail) {
  let tv1, tf1 = length(term.read([$sp]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let tv2 = term.read([var n])
  let tv3, tf3 = binary(10, tv1, tv2)
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  return tv3, null(Fail)
}

