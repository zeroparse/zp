## l_yaml_stream action
func term(c Act) (Datum, Fail) {
  let tm1 = term.kids()
  let ti2, tf2 = items(term.name([map]), term.read([$rest]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(c, 4, val.unbox(tp5), term.name([$d]), term.field([d of $d]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(c, term.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = term.elemsAbove(tm1)
  let tn10 = hull(c, false, tk9)
  let tm11 = term.kids()
  seq.step()
  let tf12 = pushItems(c, term.name([concat]), term.read([$first]))
  if (tf12 != null(Fail)) {
    return null(Datum), tf12
  }
  seq.step()
  let tf13 = pushItems(c, term.name([concat]), term.fromObj(tn10))
  if (tf13 != null(Fail)) {
    return null(Datum), tf13
  }
  let tk14 = term.elemsAbove(tm11)
  let tn15 = hull(c, false, tk14)
  let tf16 = term.fromObj(tn15)
  let tn17 = term.struct([Stream])
  let tfirst18 = true
  seq.step()
  term.setField([Documents], tn17, tf16)
  tfirst18 = cover(tn17, tf16, tfirst18)
  made(c, tn17, tfirst18)
  return term.fromObj(tn17), null(Fail)
}

